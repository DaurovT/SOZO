# SOZO — раскладка по поддоменам. Подставляется deploy/set-address.sh.
# Каждая панель на своём имени и отдаётся из корня: подпути с vite base и
# basename роутера были обходом закрытых портов, с поддоменами они не нужны.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# --- Лендинг и веб-карточка заявки (корень домена) --------------------------
server {
    listen 80;
    server_name __DOMAIN__ www.__DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name www.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    return 301 https://__DOMAIN__$request_uri;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    root /home/azureuser/SOZO/sozo/apps/landing/dist;
    index index.html;
    client_max_body_size 12m;

    # Веб-карточка: самый короткий адрес из возможных — он уходит в SMS
    location /w/  { proxy_pass http://127.0.0.1:3000; include /etc/nginx/snippets/sozo-proxy.conf; }
    # Лендинг шлёт формы лидов напрямую в API
    location /v1/ { proxy_pass http://127.0.0.1:3000; include /etc/nginx/snippets/sozo-proxy.conf; }

    # Кабинет оператора собирается с base=/operator/ и живёт здесь.
    #
    # `^~` и `index` не для красоты: без index запрос на «/operator/» уходит
    # в общий фолбэк и отдаёт лендинг — кабинет открывается только по прямой
    # ссылке на index.html. Проверка «код ответа 200» этого не показывает:
    # двести отдаёт чужой index.html.
    location ^~ /operator/ {
        alias /home/azureuser/SOZO/sozo/apps/operator-web/dist/;
        index index.html;
        try_files $uri $uri/ /operator/index.html;
    }

    # Презентация продукта. Статическая страница без сборки, поэтому отдаётся
    # прямо из репозитория. Здесь — короткая ссылка: она работает и тогда,
    # когда DNS поддомена ещё не заведён. Основной адрес — deck.__DOMAIN__.
    location ^~ /deck/ {
        alias /home/azureuser/SOZO/sozo/apps/deck/;
        index index.html;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / { try_files $uri $uri/ /index.html; }
}

# --- API + веб-карточка заявки ---------------------------------------------
server {
    listen 80;
    server_name api.__DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name api.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 12m;   # фото уходят dataURL, в API лимит 10 МБ

    # Веб-карточка живёт вне префикса /v1: её адрес уходит в SMS,
    # где каждый символ платный
    location /v1/ { proxy_pass http://127.0.0.1:3000; include /etc/nginx/snippets/sozo-proxy.conf; }
    location /w/  { proxy_pass http://127.0.0.1:3000; include /etc/nginx/snippets/sozo-proxy.conf; }
    location /    { proxy_pass http://127.0.0.1:3000; include /etc/nginx/snippets/sozo-proxy.conf; }
}

# --- Админка ----------------------------------------------------------------
server {
    listen 80;
    server_name admin.__DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name admin.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    root /home/azureuser/SOZO/sozo/apps/admin-web/dist;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
}

# --- Диспетчерская ----------------------------------------------------------
server {
    listen 80;
    server_name dispatch.__DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name dispatch.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    root /home/azureuser/SOZO/sozo/apps/dispatcher-web/dist;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
}

# --- Презентация продукта ---------------------------------------------------
server {
    listen 80;
    server_name deck.__DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name deck.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    root /home/azureuser/SOZO/sozo/apps/deck;
    index index.html;

    # Страница закрыта от поисковиков заголовком, а не только мета-тегом:
    # ссылку рассылают адресно, и в выдаче ей делать нечего. Снять — когда
    # презентацию решат сделать публичной.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Короткие адреса языков: deck.__DOMAIN__/uz/ и /en/.
    # Нужны для рассылки: англоязычному собеседнику уходит ссылка, которая
    # сразу открывается по-английски, а не «переключите вверху справа».
    # Отдельных файлов под языки нет — страница одна, язык выбирает скрипт.
    location = /uz/ { return 302 /?lang=uz; }
    location = /en/ { return 302 /?lang=en; }
    location = /ru/ { return 302 /?lang=ru; }
    location = /uz  { return 302 /?lang=uz; }
    location = /en  { return 302 /?lang=en; }
    location = /ru  { return 302 /?lang=ru; }

    location / { try_files $uri $uri/ =404; }
}

# --- Всё, что пришло не на наши имена: не отвечаем ---------------------------
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/letsencrypt/live/__CERT__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT__/privkey.pem;
    return 444;
}
