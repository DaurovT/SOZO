# Зависимости и артефакты сборки — 2,4 ГБ из 2,4 ГБ репозитория.
# Без этого файла push уйдёт часами и упрётся в лимит GitHub на 100 МБ.
node_modules/
dist/
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# iOS / Android
Pods/
.gradle/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.ipa
*.app

# Секреты. В репозитории только .env.example — реальные значения сюда не кладём
.env
.env.local
.env.*.local
*.pem
*.p12
*.keystore

# Служебное
.DS_Store
*.log
coverage/
.idea/
.vscode/

# Дизайн-канва: исходники — *.dc.html и canvas.json, собранный файл (2+ МБ) артефакт
design-home/*.html
!design-home/*.dc.html

# Ключи Firebase (push).
#
# Сервисный аккаунт — право рассылать уведомления от имени SOZO всем, у кого
# стоит приложение: в репозиторий он не попадает никогда, его место —
# /etc/sozo/fcm-service-account.json с правами 600.
#
# google-services.json и GoogleService-Info.plist секретами в строгом смысле
# не являются (они уезжают внутри приложения), но привязаны к конкретному
# проекту Firebase и разъезжаются между средами — их кладут на машину сборки,
# а не хранят в истории.
**/google-services.json
**/GoogleService-Info.plist
*-service-account*.json
*.p8
