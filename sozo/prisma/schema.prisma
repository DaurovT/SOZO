// SOZO — схема БД ядра (M0-E2-S1). Источник: DEV-02 (ER), ТЗ v2.25 §3.
// Соглашения (DEV-02): PK uuid v7 (генерируется приложением из kernel/uuid);
// tenant_id NOT NULL во всех таблицах и во всех уникальных ключах; деньги — BIGINT в тийинах;
// статусы — enum, переходы валидирует ТОЛЬКО сервис статусных машин (DEV-10).
// Группы, не вошедшие в M0 (склад, лояльность, планировщик, паспорт техники и пр.),
// добавляются миграциями в своих майлстоунах — см. DEV-02 §1 полный перечень 51 сущности.

generator client {
  provider = "prisma-client-js"
  // Путь задан явно: npm-воркспейсы кладут @prisma/client то в корень, то в
  // apps/api, и без этого `prisma generate` собирал клиент не туда, где его
  // ищет приложение — «did not initialize yet» на пустом месте
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (коды — DEV-03 / DEV-10) ----------

enum OrderType {
  b2c
  b2b
  /**
   * Аварийная. Была в графах DEV-10 с самого начала и минует оценку, но в
   * перечне её не было — заявка, созданная по аварии, не записывалась вовсе.
   */
  emergency
  warranty
  from_defect
  inspection
}

enum OrderStatus {
  new
  estimated
  pending_approval
  approved
  assigned
  master_departed
  in_progress
  addwork_approval
  completed
  verified
  awaiting_payment
  closed
  rated
  cancelled
  dispute
}

enum OrderPause {
  awaiting_materials
  tech_break
  blocked_third_party
}

enum Urgency {
  normal
  urgent
  emergency
}

enum PaymentChannel {
  subscription
  invoice
  online
  cash
}

enum PhotoStage {
  before
  during
  after
  receipt
  defect
}

enum QuoteKind {
  initial
  approved
  // Вынужденная доп-работа и апсейл различаются по последствиям: первая
  // блокирует конвейер и требует фото, второй никогда не автостартует.
  // Одно значение `additional` их смешивало, и по журналу нельзя было
  // отличить «пришлось» от «предложили»
  additional
  additional_forced
  additional_upsell
  conservation
}

enum ReleaseStatus {
  draft
  scheduled
  active
  archived
}

enum DefectStatus {
  new
  pending_approval
  approved
  postponed
  rejected
  resolved
}

enum RoleKind {
  b2c_client
  location_employee
  location_manager
  org_manager
  org_owner
  master
  dispatcher
  accountant
  admin
}

// ---------- Оргструктура и пользователи ----------

model Organization {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  inn           String
  vatPayer      Boolean  @default(false) @map("vat_payer")
  vatRate       Int?     @map("vat_rate") // проценты; ставку подтверждает бухгалтер (ТЗ 8.10)
  contractType  String   @map("contract_type") // subscription | one_off
  /**
   * Годовой договор замораживает цены, месячный переводится на текущий релиз
   * при продлении (ТЗ 3.7). Схема знала только тип договора, но не срок, а от
   * него зависит, по какому релизу считать заявку.
   */
  contractKind         String?  @map("contract_kind")
  subscriptionTiyin    BigInt?  @map("subscription_tiyin")
  /** Релиз, замороженный годовым договором; заполняется первой заявкой */
  priceReleaseIdFrozen String?  @map("price_release_id_frozen") @db.Uuid
  terminationNote      String?  @map("termination_note")
  orgRoles      String[] @map("org_roles") // client | operator | contractor — множество (DEV-15 §1); поле `roles` занято связью UserRole
  /**
   * Бизнес-код: `uk1`, `bc1`. Не идентификатор строки, а то, чем организацию
   * называют снаружи — он стоит в адресах кабинета оператора и в карточке
   * объекта. До него контур «Дом» хранил код, а CRM о такой организации не
   * знала: одна и та же компания существовала в системе дважды.
   */
  code          String?
  status        String   @default("active") // active | suspended | terminated (ТЗ 3.1)
  settingsJson  Json     @default("{}") @map("settings_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Связи с сущностями контура «Дом» сняты: оператор связан с ними своим
  // бизнес-кодом, а не идентификатором строки, и Prisma такую связь не
  // выражает. Целостность вернётся ссылкой на organization.code, когда будет
  // гарантирован порядок записи между CRM и объектами.
  locations     Location[]
  contracts     Contract[]
  roles         UserRole[]

  // Уникальность ИНН — частичным индексом (миграция m19): пустой ИНН это
  // отсутствие значения, а не значение. Организация-оператор заводится
  // заявкой на подключение, реквизиты заполняет админ позже, и до тех пор
  // таких организаций может быть сколько угодно
  @@index([tenantId, inn])
  @@index([tenantId, status])
  @@map("organization")
}

model Location {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  // Город нужен с первого дня (ТЗ 17.4), но B2B-точки заводятся адресом без
  // выбора города: пока справочника городов нет, поле пустое, а не выдуманное
  cityId            String?  @map("city_id") @db.Uuid
  name              String
  address           String
  geoLat            Decimal? @map("geo_lat") @db.Decimal(9, 6)
  geoLng            Decimal? @map("geo_lng") @db.Decimal(9, 6)
  photoForbidden    Boolean  @default(false) @map("photo_forbidden") // режимный объект (ТЗ 3.2)
  orderLimitTiyin   BigInt?  @map("order_limit_tiyin") // лимит на заявку
  monthlyLimitTiyin BigInt?  @map("monthly_limit_tiyin")
  passportJson      Json     @default("{}") @map("passport_json") // паспорт объекта: м², санузлы, кондиционеры, щитки
  accessJson        Json     @default("{}") @map("access_json") // график доступа, контакты ТСЖ/УК
  buildingId        String?  @map("building_id") @db.Uuid // точка может находиться в подключённом объекте (M7)
  preferredMasterId String?  @map("preferred_master_id") @db.Uuid
  blacklistMasters  String[] @map("blacklist_masters") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  organization    Organization     @relation(fields: [organizationId], references: [id])
  building        Building?        @relation(fields: [buildingId], references: [id])
  orders          Order[]
  representatives Representative[]

  @@index([tenantId, organizationId])
  @@index([tenantId, cityId])
  @@map("location")
}

/**
 * Ответственный на точке B2B.
 *
 * В схеме этой сущности не было вовсе, хотя на ней держится вся матрица
 * утверждений: потолок ответственного решает, кто он — сотрудник,
 * руководитель точки или руководитель организации (`roleOf`). Не путать с
 * `BuildingStaff`: там штат эксплуатирующей организации в контуре «Дом»,
 * здесь — люди клиента.
 */
model Representative {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  fullName           String   @map("full_name")
  phone              String
  role               String
  position           String?
  /**
   * Потолок утверждения. null — уровень организации, без ограничения;
   * 0 — сотрудник. Разница смысловая, и подставлять ноль вместо null
   * значит молча понизить человека в правах.
   */
  approvalLimitTiyin BigInt?  @map("approval_limit_tiyin")
  /** Кому уходит акт. Роль от этого флага НЕ зависит (DEV-15, HANDOVER §5) */
  primary            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  location Location @relation(fields: [locationId], references: [id])

  @@unique([tenantId, locationId, phone])
  @@index([tenantId, phone])
  @@map("representative")
}

/** Приглашение человека на точку: код живёт ограниченное время и отзывается */
model CrmInvite {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  locationId         String    @map("location_id") @db.Uuid
  code               String
  fullName           String?   @map("full_name")
  role               String
  position           String?
  approvalLimitTiyin BigInt?   @map("approval_limit_tiyin")
  primary            Boolean   @default(false)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz()
  usedAt             DateTime? @map("used_at") @db.Timestamptz()
  usedByPhone        String?   @map("used_by_phone")
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz()

  @@unique([tenantId, code])
  @@index([tenantId, locationId])
  @@map("crm_invite")
}

model Contract {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  kind               String // annual (цены заморожены) | monthly (перевод на текущий релиз при продлении) — ТЗ 18-п.17
  priceListReleaseId String    @map("price_list_release_id") @db.Uuid // релиз договора (ТЗ 3.7)
  subscriptionTiyin  BigInt?   @map("subscription_tiyin")
  termsJson          Json      @default("{}") @map("terms_json") // пороги утверждений, SLA, перенос остатка, программа баллов и пр. (A-07)
  startsOn           DateTime  @map("starts_on") @db.Date
  endsOn             DateTime? @map("ends_on") @db.Date
  autoRenew          Boolean   @default(false) @map("auto_renew")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  organization Organization     @relation(fields: [organizationId], references: [id])
  release      PriceListRelease @relation(fields: [priceListReleaseId], references: [id])

  @@index([tenantId, organizationId])
  @@map("contract")
}

model User {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  phone       String // вход телефон+OTP; смена номера — только через поддержку (ТЗ 14)
  fullName    String?  @map("full_name")
  language    String   @default("ru") // ru | uz — язык всех коммуникаций (ТЗ 14)
  isBlocked   Boolean  @default(false) @map("is_blocked")
  /**
   * Блокировка с причиной и временем. Схема знала только флаг, а сервис
   * хранит и то и другое: «доступ закрыт» без причины и даты бесполезно при
   * разборе — увольнение и компрометация выглядят одинаково.
   */
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz()
  blockedReason String?   @map("blocked_reason")
  /** По последнему входу видно, кто ещё пользуется доступом */
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz()
  marketingOk Boolean  @default(false) @map("marketing_ok") // отдельное согласие (ТЗ 17.12)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  roles         UserRole[]
  masterProfile MasterProfile?
  residences    UnitResident[]  // контур «Дом»: житель одного или нескольких помещений
  buildingStaff BuildingStaff[] // контур «Дом»: роли в эксплуатирующей организации

  @@unique([tenantId, phone])
  @@map("user")
}

/**
 * След входа в систему. Пишем и удачные, и неудачные: при разборе инцидента
 * важнее всего вторые — серия отказов по чужому номеру означает подбор.
 *
 * Это оперативный журнал, а не архив: в отличие от audit_log хранение
 * ограничено, и старые записи вычищаются.
 */
model LoginEvent {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  phone    String
  ok       Boolean
  reason   String?
  roles    String[]
  at       DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, at])
  @@index([tenantId, phone])
  @@map("login_event")
}

model UserRole {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           RoleKind
  organizationId String?  @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  // Контекст роли проверяется на каждом эндпоинте (ТЗ 14): роль + organization_id + location_id
  @@unique([tenantId, userId, role, organizationId, locationId])
  @@index([tenantId, userId])
  @@map("user_role")
}

model MasterProfile {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /**
   * Пользователь. НЕОБЯЗАТЕЛЕН, и это решение, а не послабление: карточка
   * мастера заводится в воронке онбординга задолго до первого входа, и
   * требовать пользователя значило бы создавать людей, которые никогда не
   * входили — они засоряли бы журнал входов и матрицу ролей. Связка в работе
   * идёт по телефону, он же и колонка ниже.
   */
  userId         String?   @unique @map("user_id") @db.Uuid
  /** Телефон — рабочий ключ: по нему выдаётся роль master при входе */
  phone          String
  fullName       String    @map("full_name")
  /** Транспорт: пешком, свой автомобиль, мотоцикл — влияет на распределение */
  transport      String?
  referrerName   String?   @map("referrer_name")
  referrerCode   String?   @map("referrer_code")
  referralBonusPaidAt DateTime? @map("referral_bonus_paid_at") @db.Timestamptz()
  /** Причина ухода: карточка не удаляется, её след остаётся в аудите */
  offboardingNote String?  @map("offboarding_note")
  // Структуры: экзамены, документы, последняя геопозиция и офлайн-очередь —
  // по ним не ищут и на них не накладывают ограничений
  skillExamsJson   Json?   @map("skill_exams_json")
  documentsJson    Json?   @map("documents_json")
  lastGeoJson      Json?   @map("last_geo_json")
  offlineQueueJson Json?   @map("offline_queue_json")
  status         String    @default("candidate") // candidate | checking | training | active | blocked (ТЗ 17.1)
  skillTags      String[]  @map("skill_tags") // только через экзамен (ТЗ 17.1)
  /**
   * Зоны мастера — НАЗВАНИЯ районов, а не ссылки. В схеме стоял массив uuid,
   * но справочника зон как сущности не существует: и распределение, и
   * карточка оперируют строками «Чиланзар», «Яккасарай». Тип приведён к
   * реальности; появится справочник — будет отдельная миграция со связью.
   */
  zoneIds        String[]  @map("zone_ids")
  rating         Int       @default(60) // 0–100, старт 60 (ТЗ 7.4); MVP — вручную диспетчером
  grade          String    @default("bronze") // bronze | silver | gold; доля — из грейда копией на момент закрытия
  taxMode        String    @map("tax_mode") // self_employed | gph
  contractUntil  DateTime? @map("contract_until") @db.Date // ГПХ: алерт за 14 дней
  hasVehicle     Boolean   @default(false) @map("has_vehicle")
  cashDebtTiyin  BigInt    @default(0) @map("cash_debt_tiyin") // лимит 2 000 000 сум → снятие с линии (ТЗ 8.5)
  onProbation    Boolean   @default(true) @map("on_probation") // первые 20 заявок: 100% модерации фото
  probationCount Int       @default(0) @map("probation_count")
  qrBadgeCode    String?   @unique @map("qr_badge_code") // неперебираемый код верификации (L-07)
  referrerId     String?   @map("referrer_id") @db.Uuid
  // ---- контур «Дом» (M7): принадлежность НЕ единична, см. MasterAffiliation (DEV-15 §7.8) ----
  platformStatus Boolean   @default(true) @map("platform_status") // свободный мастер платформы
  qualifications Json      @default("[]") // [{type, doc_no, issued_at, valid_until}] — проверяется при выдаче наряда
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user         User?               @relation(fields: [userId], references: [id])
  orders       Order[]
  affiliations MasterAffiliation[]

  @@index([tenantId, status])
  @@map("master_profile")
}

// ---------- Прайс (релизная модель, ТЗ 3.7) ----------

model PriceListRelease {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  number      Int // релиз №1 — стартовый прайс (A-32)
  status      ReleaseStatus @default(draft)
  activatesAt DateTime?     @map("activates_at") @db.Timestamptz() // не раньше +7 дней от подтверждения (таймер #50)
  /**
   * Когда релиз стал действующим. Не то же, что `activatesAt`: там плановый
   * срок, здесь факт. Схема знала только план, а прайс заявки фиксируется
   * по факту — и без этой даты нельзя ответить, по какому релизу считали.
   */
  activatedAt DateTime?     @map("activated_at") @db.Timestamptz()
  coeffsJson  Json          @default("{}") @map("coeffs_json") // снапшот глобальных коэффициентов (A-05)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  items     PriceItem[]
  contracts Contract[]
  orders    Order[]

  // Активные релизы и их позиции иммутабельны (инвариант DEV-02 §3.2) — правки только в draft
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("price_list_release")
}

model PriceItem {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  releaseId        String   @map("release_id") @db.Uuid
  /** Номер позиции в каталоге: по нему владелец находит строку в прайсе */
  num              Int      @default(0)
  category         String
  name             String
  /**
   * Название для узбекского интерфейса. Ведёт владелец в админке: перевести
   * каталог услуг разработчик не может — это содержимое бизнеса, и меняется
   * оно вместе с прайсом.
   */
  nameUz           String?  @map("name_uz")
  unit             String // шт | точка | п.м | м² | час | выезд | объект | стык | створка | заявка | день | комплект
  priceFromTiyin   BigInt   @map("price_from_tiyin")
  priceToTiyin     BigInt   @map("price_to_tiyin")
  // Нормо-часы заполняет владелец (DEV-05 п.17); пока не заполнены — null,
  // и планировщик такую позицию не берёт. NOT NULL здесь означал бы ноль
  // часов, то есть работу, которая якобы не занимает времени
  normHours        Decimal? @map("norm_hours") @db.Decimal(5, 2)
  requiredSkills   String[] @map("required_skills")
  requiresEquip    Boolean  @default(false) @map("requires_equipment")
  isPaired         Boolean  @default(false) @map("is_paired") // цена включает второго исполнителя
  isStaged         Boolean  @default(false) @map("is_staged") // этапная: план этапов с паузами (ТЗ 4.1)
  note             String?
  stagePlanJson    Json?    @map("stage_plan_json") // [{этап, нормо-часы, пауза [мин; макс]}]
  isLicensedClosed Boolean  @default(false) @map("is_licensed_closed") // газ/лифты до договора с лицензиатом (ТЗ 17.8)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  release PriceListRelease @relation(fields: [releaseId], references: [id])

  @@index([tenantId, releaseId, category])
  @@map("price_item")
}

// ---------- Контур «Дом»: сущности, которых не было в схеме ----------

/**
 * Прайс эксплуатирующей организации. Свой, а не платформенный: оператор
 * обслуживает жителей по своим ценам, и подменять их прайсом платформы —
 * значит выставить чужие деньги за свою работу.
 */
model OperatorPriceItem {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  operatorOrgId  String   @map("operator_org_id")
  /** null — прайс на все объекты оператора; иначе переопределение на объект */
  buildingId     String?  @map("building_id") @db.Uuid
  name           String
  unit           String
  priceFromTiyin BigInt   @map("price_from_tiyin")
  priceToTiyin   BigInt   @map("price_to_tiyin")
  scope          String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, operatorOrgId])
  @@map("operator_price_item")
}

/** Заявка оператора на подключение объекта: проверяется модератором (A-39) */
model BuildingClaim {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  operatorOrgId  String    @map("operator_org_id")
  operatorName   String    @map("operator_name")
  applicantPhone String    @map("applicant_phone")
  documentKind   String    @map("document_kind")
  documentId     String?   @map("document_id")
  contactPhone   String?   @map("contact_phone")
  status         String    @default("pending")
  callbackResult String?   @map("callback_result")
  decisionBy     String?   @map("decision_by")
  decisionAt     DateTime? @map("decision_at") @db.Timestamptz()
  decisionReason String?   @map("decision_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, status])
  @@map("building_claim")
}

/**
 * Спрос по адресу: житель просит подключить свой дом. Повторные обращения
 * усиливают один адрес, а не плодят строки — по этому счётчику решают,
 * куда идти продавать.
 */
model DemandSignal {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  address   String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, address])
  @@map("demand_signal")
}

/** Маршрут обхода: периодичность и зоны (M-48) */
model WalkthroughRoute {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  buildingId   String    @map("building_id") @db.Uuid
  name         String
  intervalDays Int       @map("interval_days")
  zoneKeys     String[]  @map("zone_keys")
  lastWalkAt   DateTime? @map("last_walk_at") @db.Timestamptz()
  isActive     Boolean   @default(true) @map("is_active")

  @@index([tenantId, buildingId])
  @@map("walkthrough_route")
}

/** Пройденный обход: кто, когда, какие зоны и что зафиксировал */
model Walkthrough {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  routeId        String    @map("route_id") @db.Uuid
  routeName      String    @map("route_name")
  walkerPhone    String    @map("walker_phone")
  startedAt      DateTime  @map("started_at") @db.Timestamptz()
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz()
  passedZones    String[]  @map("passed_zones")
  observationIds String[]  @map("observation_ids") @db.Uuid

  @@index([tenantId, buildingId])
  @@map("walkthrough")
}

/**
 * Сессия планового ТО (M-47). Отдельная сущность, а не поле у оборудования:
 * `last_service_at` отвечает «когда», а надзору нужен ответ «что именно
 * проверили и кто» — с отметками по пунктам и фото.
 */
model MaintenanceSession {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  equipmentId    String    @map("equipment_id") @db.Uuid
  /** копия типа на момент работы: регламент может смениться, запись — нет */
  equipmentType  String    @map("equipment_type")
  masterPhone    String    @map("master_phone")
  startedAt      DateTime  @map("started_at") @db.Timestamptz()
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz()
  itemsJson      Json      @default("[]") @map("items_json")
  observationIds String[]  @map("observation_ids") @db.Uuid

  @@index([tenantId, equipmentId])
  @@map("maintenance_session")
}

// ---------- Заявка (центральная сущность, ТЗ 3.4) ----------

model Order {
  id                 String         @id @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  number             String // Z-2026-000123
  type               OrderType
  urgency            Urgency        @default(normal)
  status             OrderStatus    @default(new)
  pause              OrderPause?
  version            Int            @default(0) // оптимистичная блокировка переходов (DEV-10 §3.6)
  source             String? // app | phone | landing | inspection_schedule
  clientId           String?        @map("client_id") @db.Uuid // CHECK в миграции: ровно одно из client_id/location_id по типу
  locationId         String?        @map("location_id") @db.Uuid
  applicantUserId    String?        @map("applicant_user_id") @db.Uuid // программа баллов (ТЗ 17.14)
  masterId           String?        @map("master_id") @db.Uuid
  helperId           String?        @map("helper_id") @db.Uuid // парная (ТЗ 4.5)
  // Релиз может быть не определён: аварийная заявка создаётся минуя оценку,
  // и до сметы привязывать её к прайсу не к чему
  priceListReleaseId String?        @map("price_list_release_id") @db.Uuid
  parentOrderId      String?        @map("parent_order_id") @db.Uuid // гарантийная / дробление
  defectId           String?        @map("defect_id") @db.Uuid
  addressJson        Json           @default("{}") @map("address_json") // улица/дом на создании; детали — C-50 после назначения
  coefficientsCopy   Json           @default("{}") @map("coefficients_copy") // копия коэффициентов на момент создания
  totalWorkTiyin     BigInt         @default(0) @map("total_work_tiyin")
  totalMaterialTiyin BigInt         @default(0) @map("total_material_tiyin")
  paymentChannel     PaymentChannel @map("payment_channel")
  warrantyDaysCopy   Int            @default(30) @map("warranty_days_copy")
  promoCode          String?        @map("promo_code")
  rating             Int? // 1–5, окно 72 ч
  partiallyDone      Boolean        @default(false) @map("partially_done") // консервация (ТЗ 4.6)
  isDemo             Boolean        @default(false) @map("is_demo") // демо-контур вне биллинга/отчётов (DEV-02 §3.4)
  clientUuid         String?        @map("client_uuid") @db.Uuid // офлайн-идемпотентность
  // ---- контур «Дом» (M7, DEV-15 §3) ----
  buildingId         String?        @map("building_id") @db.Uuid
  unitId             String?        @map("unit_id") @db.Uuid
  orderScope         OrderScope     @default(private) @map("order_scope") // сбор не начисляется на common_area (инвариант DEV-02 §4.4 п.7)
  laborSettlement    LaborSettlement @default(share) @map("labor_settlement") // выводится из владельца смены, не из типа мастера
  serviceFeeTiyin    BigInt         @default(0) @map("service_fee_tiyin")
  firstRefusalUntil  DateTime?      @map("first_refusal_until") @db.Timestamptz()
  slaPolicyId        String?        @map("sla_policy_id") @db.Uuid
  slaResponseDue     DateTime?      @map("sla_response_due") @db.Timestamptz()
  slaArrivalDue      DateTime?      @map("sla_arrival_due") @db.Timestamptz()
  slaResolutionDue   DateTime?      @map("sla_resolution_due") @db.Timestamptz()
  slaBreachFlags     String[]       @map("sla_breach_flags") // response | arrival | resolution

  // ---------- Поля, которых схема не знала (миграция m12_orders) ----------
  //
  // Деление по правилу DEV-02, а не по удобству: деньги, время, ключи и всё,
  // по чему ищут или что ограничивают — колонки, иначе на них не наложить
  // CHECK и не построить индекс. Структурные снимки — jsonb, как уже сделано
  // для coefficients_copy и passport.

  /**
   * Телефон клиента. В ER заявка ссылается на client_id, но B2C-клиент
   * заводится самим фактом заявки, и телефон — единственный устойчивый
   * идентификатор: по нему собирается вся личная лента. Колонка, а не поиск
   * через связь, потому что этот запрос самый частый в системе.
   */
  clientPhone             String    @map("client_phone")
  clientName              String?   @map("client_name")
  organizationId          String?   @map("organization_id") @db.Uuid
  description             String?
  address                 String
  geoLat                  Decimal?  @map("geo_lat") @db.Decimal(9, 6)
  geoLng                  Decimal?  @map("geo_lng") @db.Decimal(9, 6)

  /** Денормализованные имена: список заявок не должен join'ить мастера ради подписи */
  masterName              String?   @map("master_name")
  helperName              String?   @map("helper_name")

  restrictedSite          Boolean   @default(false) @map("restricted_site")
  arrivedAt               DateTime? @map("arrived_at") @db.Timestamptz()
  claimedByOperator       String?   @map("claimed_by_operator")
  releasedReason          String?   @map("released_reason")

  // Деньги — BIGINT в тийинах (DEV-02): вилка цены, итог и чаевые
  baseFromTiyin           BigInt    @default(0) @map("base_from_tiyin")
  baseToTiyin             BigInt    @default(0) @map("base_to_tiyin")
  totalFromTiyin          BigInt    @default(0) @map("total_from_tiyin")
  totalToTiyin            BigInt    @default(0) @map("total_to_tiyin")
  tipTiyin                BigInt    @default(0) @map("tip_tiyin")

  promoDiscountPercent    Int       @default(0) @map("promo_discount_percent")
  urgentSurchargePercent  Int       @default(0) @map("urgent_surcharge_percent")
  preferredMasterId       String?   @map("preferred_master_id") @db.Uuid
  slaDueAt                DateTime? @map("sla_due_at") @db.Timestamptz()
  rescheduleCount         Int       @default(0) @map("reschedule_count")
  /** Код приёмки ищут по значению — поэтому колонка, а не поле внутри JSON */
  acceptanceCode          String?   @map("acceptance_code")

  // Структурные снимки: на них не накладывают CHECK и по ним не ищут
  acceptanceJson          Json?     @map("acceptance_json")
  acceptanceRequestJson   Json?     @map("acceptance_request_json")
  addressDetailsJson      Json?     @map("address_details_json")
  paymentJson             Json?     @map("payment_json")
  requestedWindowJson     Json?     @map("requested_window_json")
  commonAreaAccessJson    Json?     @map("common_area_access_json")
  slaPausedMs        BigInt         @default(0) @map("sla_paused_ms")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  location  Location?        @relation(fields: [locationId], references: [id])
  master    MasterProfile?   @relation(fields: [masterId], references: [id])
  building  Building?        @relation(fields: [buildingId], references: [id])
  unit      Unit?            @relation(fields: [unitId], references: [id])
  slaPolicy SlaPolicy?       @relation(fields: [slaPolicyId], references: [id])
  permits   AccessPermit[]
  passes    VisitPass[]
  release   PriceListRelease? @relation(fields: [priceListReleaseId], references: [id])
  lines     OrderLine[]
  quotes    Quote[]
  photos    OrderPhoto[]
  materials OrderMaterial[]
  statusLog OrderStatusLog[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientUuid])
  @@index([tenantId, status])
  @@index([tenantId, locationId, createdAt]) // дубль-детект за 24 ч
  @@index([tenantId, masterId, status])
  @@index([tenantId, buildingId, status]) // очереди кабинета оператора
  @@index([tenantId, firstRefusalUntil]) // окно первой руки
  @@map("order")
}

model OrderLine {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  priceItemId    String?  @map("price_item_id") @db.Uuid
  nameCopy       String   @map("name_copy") // копии на момент фиксации (инвариант DEV-02 §3.2)
  unitCopy       String   @map("unit_copy")
  /** Вилка цены на момент заявки: прайс хранит диапазон, а не одну цену */
  priceFromTiyinCopy BigInt @map("price_from_tiyin_copy") @default(0)
  priceToTiyinCopy   BigInt @map("price_to_tiyin_copy") @default(0)
  priceTiyinCopy BigInt   @map("price_tiyin_copy")
  normHoursCopy  Decimal  @map("norm_hours_copy") @db.Decimal(5, 2)
  qty            Decimal  @default(1) @db.Decimal(8, 2)
  stagePlanCopy  Json?    @map("stage_plan_copy")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_line")
}

model Quote {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  kind          QuoteKind
  amountTiyin   BigInt    @map("amount_tiyin")
  positionsJson Json      @map("positions_json")
  evidenceJson  Json?     @map("evidence_json") // фото+причина по подорожавшим позициям (ТЗ 17.17 п.4)
  approvedBy    String?   @map("approved_by") @db.Uuid
  /** Пояснение к смете: почему сумма такая — его читает клиент */
  note        String?
  approvedVia   String?   @map("approved_via") // app | web_card | phone_dispatcher | offline_signature
  offlineFlag   Boolean   @default(false) @map("offline_flag") // «согласовано офлайн» → выборочная модерация
  clientUuid    String?   @map("client_uuid") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  @@unique([tenantId, clientUuid])
  @@index([tenantId, orderId])
  @@map("quote")
}

model OrderStatusLog {
  id           String      @id @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus @map("to_status")
  action       String // TransitionAction (DEV-10 §2)
  actorId      String?     @map("actor_id") @db.Uuid
  /** Телефон действующего лица — по нему разбирают, кто двигал заявку */
  actorPhone String? @map("actor_phone")
  actorRole    String?     @map("actor_role")
  reason       String?
  clientUuid   String?     @map("client_uuid") @db.Uuid
  deviceTime   DateTime?   @map("device_time") @db.Timestamptz() // двойные метки времени (ТЗ 7.2)
  offlineFixed Boolean     @default(false) @map("offline_fixed")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  // Append-only (REVOKE UPDATE/DELETE в миграции); идемпотентность переходов (DEV-10 §3.5)
  @@unique([tenantId, orderId, fromStatus, toStatus, clientUuid])
  @@index([tenantId, orderId, createdAt])
  @@map("order_status_log")
}

model OrderPhoto {
  id         String     @id @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  orderId    String     @map("order_id") @db.Uuid
  stage      PhotoStage
  /** Откуда снимок: приложение мастера, dev-флаг диспетчера, витрина */
  source      String  @default("")
  /** Ключ в хранилище; пусто у отметки диспетчера, сделанной без файла */
  s3Key      String?     @map("s3_key") // доступ только по signed URL; закрытые заявки — вечное хранение (ТЗ 14)
  serverTs   DateTime   @default(now()) @map("server_ts") @db.Timestamptz()
  deviceTs   DateTime?  @map("device_ts") @db.Timestamptz()
  geoLat     Decimal?   @map("geo_lat") @db.Decimal(9, 6) // null допустим с флагом (ТЗ 7.2)
  geoLng     Decimal?   @map("geo_lng") @db.Decimal(9, 6)
  geoMissing Boolean    @default(false) @map("geo_missing")
  hash       String?
  clientUuid String?    @map("client_uuid") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  @@unique([tenantId, clientUuid])
  @@index([tenantId, orderId, stage])
  @@map("order_photo")
}

model OrderMaterial {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  kind           String // spare_part (чек обязателен) | consumable (фикс-прайс «сумки», без чека) — ТЗ 8.4
  name           String
  amountTiyin    BigInt   @map("amount_tiyin")
  sourceChannel  String   @map("source_channel") // partner_store | master_own | client_self | company_stock
  /** Чек приложен. Запчасть без чека не принимается (ТЗ 8.4) */
  hasReceipt     Boolean @default(false) @map("has_receipt")
  receiptPhotoId String?  @map("receipt_photo_id") @db.Uuid
  priceTier      String?  @map("price_tier") // economy | standard | premium (порог 200 000, ТЗ 8.4.3)
  clientUuid     String?  @map("client_uuid") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  @@unique([tenantId, clientUuid])
  @@index([tenantId, orderId])
  @@map("order_material")
}

model Defect {
  id                String       @id @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  locationId        String       @map("location_id") @db.Uuid
  foundInOrderId    String?      @map("found_in_order_id") @db.Uuid
  status            DefectStatus @default(new)
  priority          String // critical | high | medium | low (ТЗ 3.5)
  description       String
  estimateJson      Json?        @map("estimate_json")
  estimateTiyin     BigInt?      @map("estimate_tiyin")
  estimateReleaseId String?      @map("estimate_release_id") @db.Uuid // заявка из дефекта наследует релиз оценки
  estimateValidTill DateTime?    @map("estimate_valid_till") @db.Date // 30 дней (ТЗ 3.5)
  postponedUntil    DateTime?    @map("postponed_until") @db.Date
  resolvedByOrderId String?      @map("resolved_by_order_id") @db.Uuid
  rejectedNoteDate  DateTime?    @map("rejected_note_date") @db.Date // «предупреждали {дата}» — юрзащита (ТЗ 10)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, locationId, status])
  @@map("defect")
}

// ---------- Биллинг (двойная запись, ТЗ 8.1/8.8) ----------

model Account {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String // план счетов PRD-05 §4.3
  name     String
  kind     String // asset | liability | income | expense

  debits  Transaction[] @relation("debit")
  credits Transaction[] @relation("credit")

  @@unique([tenantId, code])
  @@map("account")
}

model Transaction {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  operationId     String   @map("operation_id") @db.Uuid // Σ проводок операции = 0 (инвариант DEV-02 §3.1)
  debitAccountId  String   @map("debit_account_id") @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  amountTiyin     BigInt   @map("amount_tiyin") // CHECK > 0 в миграции
  type            String // сценарии PRD-05 §4.4 (23 шт.)
  orderId         String?  @map("order_id") @db.Uuid
  invoiceId       String?  @map("invoice_id") @db.Uuid
  isStorno        Boolean  @default(false) @map("is_storno")
  reversedTxId    String?  @map("reversed_tx_id") @db.Uuid
  /** Доли и удержания считаются и штатному мастеру оператора — карточки нет (см. m21) */
  masterId        String?  @map("master_id")
  /** Основание проводки прямым текстом: бухгалтер читает ведомость, не выходя из неё */
  comment         String?
  idemKey         String?  @map("idem_key") // (provider, payment_id) для вебхуков
  periodLocked    Boolean  @default(false) @map("period_locked") // проводки в закрытый период отклоняет триггер
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  debitAccount  Account @relation("debit", fields: [debitAccountId], references: [id])
  creditAccount Account @relation("credit", fields: [creditAccountId], references: [id])

  // Append-only: REVOKE UPDATE/DELETE в миграции; исправления — только сторно
  @@unique([tenantId, idemKey])
  @@index([tenantId, operationId])
  @@index([tenantId, orderId])
  @@map("transaction")
}

model SubscriptionAccount {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  balanceTiyin   BigInt   @default(0) @map("balance_tiyin") // витрина по проводкам; абонентка — аванс, не выручка (ТЗ 8.8)
  reservedTiyin  BigInt   @default(0) @map("reserved_tiyin") // резерв плановых осмотров (ТЗ 8.3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("subscription_account")
}

model Invoice {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  number         String // INV-…
  organizationId String    @map("organization_id") @db.Uuid
  kind           String // subscription | overlimit | one_off_prepayment | materials
  amountTiyin    BigInt    @map("amount_tiyin")
  vatTiyin       BigInt    @default(0) @map("vat_tiyin") // НДС изнутри (÷1.12) для плательщиков
  status         String    @default("issued") // issued | paid | overdue | cancelled
  /**
   * Снимок на момент выставления: организация может сменить название или
   * перестать быть плательщиком НДС, а выставленный счёт от этого не меняется
   * — это бухгалтерский факт, а не текущее состояние справочника.
   */
  organizationName String  @default("") @map("organization_name")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz()
  vatRatePercent Int       @default(0) @map("vat_rate_percent")
  dueOn          DateTime? @map("due_on") @db.Date
  pdfS3Key       String?   @map("pdf_s3_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, status])
  @@map("invoice")
}

model Receivable {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  debtorType   String   @map("debtor_type") // organization | b2c_client | master_cash
  debtorId     String   @map("debtor_id") @db.Uuid
  invoiceId    String?  @map("invoice_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  amountTiyin  BigInt   @map("amount_tiyin")
  repaidTiyin  BigInt   @default(0) @map("repaid_tiyin") // FIFO-разнесение (ТЗ 8.9)
  dunningStage String?  @map("dunning_stage")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, debtorType, debtorId])
  @@map("receivable")
}

// ---------- Системные ----------

model AuditLog {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /**
   * Телефон действующего лица. Схема писалась по DEV-02 раньше сервиса, и
   * они разошлись: код везде пишет `actorPhone`, а `actor_id` — uuid, куда
   * телефон не ложится. Держать одно вместо другого нельзя: разбор инцидента
   * начинается с номера, по которому пришла жалоба.
   */
  actorPhone String? @map("actor_phone")
  actorRole String?  @map("actor_role")
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  payload   Json     @default("{}")
  device    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Append-only навечно (REVOKE UPDATE/DELETE в миграции) — ТЗ 14
  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String // domain.event_name (DEV-07 §5, каталог DEV-03 x-events)
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz()
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, processedAt, createdAt]) // воркеры BullMQ разбирают по порядку
  @@map("outbox_event")
}

model SystemParameter {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String // 123 параметра PRD-04 §5; в коде магических чисел нет (DoD п.6)
  value     Json
  level     String // global | contract | location | price
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([tenantId, code])
  @@map("system_parameter")
}

// ============================================================
// КОНТУР «ДОМ» (M7/M8) — DEV-15, DEV-02 §4
// Все таблицы ниже несут арендаторское измерение operator_org_id (прямо или через building)
// и обязаны получить RLS-политику в той же миграции (DEV-07 §8, тест-страж роняет CI).
// ============================================================

enum BuildingConnectionStatus {
  unmanaged
  claimed
  verified
  active
  degraded
}

enum BuildingType {
  residential
  business_center
  mixed
}

enum OrderScope {
  private
  common_area
}

enum LaborSettlement {
  salary // работа в смене оператора: доля не начисляется, платит оператор (DEV-15 §8.5)
  share  // свободное время: доля от базового прайса (ТЗ 8.1)
}

enum PermitStatus {
  draft
  requested
  approved
  rescheduled
  rejected
  scheduled
  opened
  closed
  expired
  cancelled
}

enum PermitApprovalKind {
  manual
  auto_silence       // запрещено для критичных зон (DEV-15 §9.3)
  emergency_override // вскрытие без согласования (DEV-15 §4.5)
}

enum ShutdownStatus {
  draft
  scheduled
  active
  restored
  cancelled
}

enum ResourceType {
  cold_water
  hot_water
  heating
  electricity
  gas
  sewage
  lift
  ventilation
}

enum PassType {
  master
  helper
  guest
  resident_contractor
  operator_contractor
}

enum ResidentRole {
  owner
  tenant
  family
}

enum StaffRole {
  master
  approver
  dispatcher
  engineer
  head
  admin
}

enum ObservationSeverity {
  emergency
  work_required
  housekeeping
  info
}

enum ObservationSource {
  walkthrough
  resident
  master
  complaint
}

enum SubscriptionPlan {
  free
  pro
  enterprise
}

enum BillingUnit {
  per_object // действующая единица: плоская ставка за объект (ТЗ 19.3 п.2)
  per_unit   // за помещение — поддерживается на случай пересмотра
}

enum TenantKind {
  hoa
  bc
  inhouse
  fm
}

model Building {
  id                 String                   @id @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  operatorOrgId      String?                  @map("operator_org_id")
  cityId             String?                   @map("city_id") @db.Uuid
  name               String
  address            String
  geoPolygon         Json                     @default("{}") @map("geo_polygon")
  buildingType       BuildingType             @default(residential) @map("building_type")
  connectionStatus   BuildingConnectionStatus @default(unmanaged) @map("connection_status")
  workHoursJson      Json                     @default("{}") @map("work_hours_json")  // часы работ объекта
  noiseHoursJson     Json                     @default("{}") @map("noise_hours_json") // часы шумных работ
  hasServiceLift     Boolean                  @default(false) @map("has_service_lift")
  parkingRules       String?                  @map("parking_rules")
  wasteRules         String?                  @map("waste_rules")
  internalBufferMin  Int                      @default(0) @map("internal_buffer_min") // проход охрана/лифт (DEV-15 §11.4.8)
  emergencyPhone     String?                  @map("emergency_phone") // обязателен для active
  dispatchPhone      String?                  @map("dispatch_phone")
  serviceFeeBps      Int                      @default(500) @map("service_fee_bps") // CHECK 0..1000 в миграции (потолок 10%)
  verifiedBy         String?                  @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz()
  connectedAt        DateTime?                @map("connected_at") @db.Timestamptz()
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()
  units         Unit[]
  zones         CommonZone[]
  staff         BuildingStaff[]
  equipment     BuildingEquipment[]
  announcements BuildingAnnouncement[]
  shutdowns     ResourceShutdown[]
  observations  BuildingObservation[]
  permits       AccessPermit[]
  passes        VisitPass[]
  unitAccess    UnitAccessRequest[]
  orders        Order[]
  locations     Location[]

  @@index([tenantId, operatorOrgId])
  @@index([tenantId, connectionStatus])
  @@index([tenantId, cityId])
  @@map("building")
  /**
   * Часы работы службы и часы, когда разрешены шумные работы. Разные вещи:
   * консьерж на месте с 8 до 20, а сверлить можно с 10 до 18 — наряд вне
   * этого окна не согласуется, и без обоих интервалов правило не проверить.
   */
  workFrom  String? @map("work_from")
  workTo    String? @map("work_to")
  noiseFrom String? @map("noise_from")
  noiseTo   String? @map("noise_to")

  /**
   * Счётчики деградации за 30 дней (DEV-15 §9.3). Держатся колонками, а не
   * считаются запросом: по ним принимается решение о переводе объекта в
   * деградированный режим, и оно должно быть воспроизводимым, а не зависеть
   * от того, когда посмотрели.
   */
  permitsTotal30d     Int @default(0) @map("permits_total_30d")
  permitsOverdue30d   Int @default(0) @map("permits_overdue_30d")
  emergencyOverdue30d Int @default(0) @map("emergency_overdue_30d")

  // Обратная связь: политики SLA этого объекта (точки B2B — выше, locations)
  slaPolicies SlaPolicy[]
}

model Unit {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  entrance   String?
  floor      Int?
  number     String
  unitType   String   @default("apartment") @map("unit_type") // apartment | office | storage | parking
  areaM2     Decimal? @map("area_m2") @db.Decimal(10, 2)
  riserIds   String[] @map("riser_ids") // зона влияния отключения считается по стоякам
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  building     Building              @relation(fields: [buildingId], references: [id])
  residents    UnitResident[]
  orders       Order[]
  observations BuildingObservation[]

  @@unique([tenantId, buildingId, entrance, number])
  @@index([tenantId, buildingId])
  @@map("unit")
}

model UnitResident {
  id           String       @id @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  unitId       String       @map("unit_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  residentRole ResidentRole @default(owner) @map("resident_role")
  verifiedBy   String       @default("self") @map("verified_by") // operator | document | self | crowd
  validUntil   DateTime?    @map("valid_until") @db.Timestamptz()
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  unit Unit @relation(fields: [unitId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([tenantId, unitId, userId])
  @@index([tenantId, userId])
  @@map("unit_resident")
}

model CommonZone {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  zoneType   String   @map("zone_type") // справочник A-41
  label      String
  riserId    String?  @map("riser_id")
  isCritical Boolean  @default(false) @map("is_critical") // запрещает auto_silence всегда
  isLicensed Boolean  @default(false) @map("is_licensed") // мастерам платформы наряд не выдаётся (ТЗ 17.8)
  accessNote String?  @map("access_note")
  keyHolder  String?  @map("key_holder")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  building Building @relation(fields: [buildingId], references: [id])

  @@index([tenantId, buildingId])
  @@map("common_zone")
}

model AccessPermit {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  orderId         String              @map("order_id") @db.Uuid
  buildingId      String              @map("building_id") @db.Uuid
  /** Наряд просит мастер: у штатного работника оператора учётной записи нет */
  requestedByPhone String             @map("requested_by_phone")
  status          PermitStatus        @default(draft)
  version         Int                 @default(0) // оптимистичная блокировка переходов (DEV-10 §7)
  zoneTypes       String[]            @map("zone_types")
  /**
   * Снимок свойств зон на момент выписки. Не вычисляются по zoneTypes: ими
   * решается, кого пускать (ТЗ 17.8), и решение должно пережить правку
   * справочника зон.
   */
  hasCriticalZone Boolean             @default(false) @map("has_critical_zone")
  hasLicensedZone Boolean             @default(false) @map("has_licensed_zone")
  commonZoneIds   String[]            @map("common_zone_ids") @db.Uuid
  requiresShutdown Boolean            @default(false) @map("requires_shutdown")
  shutdownId      String?             @map("shutdown_id") @db.Uuid
  affectedUnitIds String[]            @map("affected_unit_ids") @db.Uuid
  windowFrom      DateTime?           @map("window_from") @db.Timestamptz()
  windowTo        DateTime?           @map("window_to") @db.Timestamptz()
  /** Согласующий объекта — консьерж или инженер, тоже без учётной записи */
  approverName    String?             @map("approver_name")
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz()
  approvalKind    PermitApprovalKind? @map("approval_kind")
  rejectReason    String?             @map("reject_reason")
  escortRequired  Boolean             @default(false) @map("escort_required")
  escortUserId    String?             @map("escort_user_id") @db.Uuid
  openedAt        DateTime?           @map("opened_at") @db.Timestamptz()
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz()
  photoBeforeId   String?             @map("photo_before_id") @db.Uuid
  photoAfterId    String?             @map("photo_after_id") @db.Uuid
  slaDeadline     DateTime?           @map("sla_deadline") @db.Timestamptz()
  isEmergency     Boolean             @default(false) @map("is_emergency")
  /**
   * Кто идёт по наряду. Колонка, а не связь: штатный мастер оператора
   * карточки в masters не имеет — его допуск декларирует оператор
   * (DEV-15 §7.1.2), и внешний ключ отсёк бы именно этот случай.
   * CHECK в m21: два основания допуска исключают друг друга.
   */
  masterId             String?        @map("master_id")
  masterIsPlatform     Boolean        @default(true) @map("master_is_platform")
  operatorSelfDeclared Boolean        @default(false) @map("operator_self_declared")
  qualificationOk      Boolean        @default(false) @map("qualification_ok")
  clientOpUuid    String?             @map("client_op_uuid") @db.Uuid // идемпотентность офлайн-синка мастера
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  order    Order             @relation(fields: [orderId], references: [id])
  building Building          @relation(fields: [buildingId], references: [id])
  shutdown ResourceShutdown? @relation(fields: [shutdownId], references: [id])
  unitAccess UnitAccessRequest[]

  @@unique([tenantId, clientOpUuid])
  @@index([tenantId, buildingId, status])
  @@index([tenantId, status, slaDeadline]) // очередь U-02 и D-21 по остатку SLA
  @@map("access_permit")
}

model ResourceShutdown {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  buildingId      String         @map("building_id") @db.Uuid
  resourceType    ResourceType   @map("resource_type")
  scope           String         @default("riser") // building | entrance | riser | units
  riserId         String?        @map("riser_id")
  affectedUnitIds String[]       @map("affected_unit_ids") @db.Uuid
  plannedFrom     DateTime       @map("planned_from") @db.Timestamptz()
  plannedTo       DateTime       @map("planned_to") @db.Timestamptz()
  actualFrom      DateTime?      @map("actual_from") @db.Timestamptz()
  actualTo        DateTime?      @map("actual_to") @db.Timestamptz()
  reason          String
  initiator       String         @default("operator") // operator | platform | utility
  orderId         String?        @map("order_id") @db.Uuid
  status          ShutdownStatus @default(draft)
  notifiedAt      DateTime?      @map("notified_at") @db.Timestamptz()
  /** Метки ставятся при создании и не пересматриваются: срок публикации у объектов разный */
  lateNotice      Boolean        @default(false) @map("late_notice")
  isEmergency     Boolean        @default(false) @map("is_emergency")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  building Building       @relation(fields: [buildingId], references: [id])
  permits  AccessPermit[]

  // EXCLUDE-ограничение на пересечение (riser_id, [planned_from, planned_to)) для scheduled|active — в миграции
  @@index([tenantId, buildingId, plannedFrom])
  @@index([tenantId, riserId, status])
  @@map("resource_shutdown")
}

model VisitPass {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  buildingId   String    @map("building_id") @db.Uuid
  orderId      String?   @map("order_id") @db.Uuid
  /** Не только мастер платформы: пропуск бывает и подрядчику жителя (см. m21) */
  masterId     String?   @map("master_id")
  guestName    String?   @map("guest_name")
  passType     PassType  @default(master) @map("pass_type")
  issuedBy     String    @default("system") @map("issued_by") // system | operator | resident
  qrToken      String    @unique @map("qr_token")
  fallbackCode String    @map("fallback_code") // на случай отсутствия сети у охраны
  carPlate     String?   @map("car_plate")
  validFrom    DateTime  @map("valid_from") @db.Timestamptz()
  validTo      DateTime  @map("valid_to") @db.Timestamptz()
  enteredAt    DateTime? @map("entered_at") @db.Timestamptz()
  exitedAt     DateTime? @map("exited_at") @db.Timestamptz()
  checkedBy    String?   @map("checked_by")
  status       String    @default("active") // active | used | revoked | expired
  /** Гостевой пропуск (C-54): кто выписал и какая подпись помещения напечатана */
  issuedByPhone String?  @map("issued_by_phone")
  unitLabel    String?   @map("unit_label")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  building Building       @relation(fields: [buildingId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])

  @@index([tenantId, buildingId, validFrom])
  @@index([tenantId, masterId, status])
  @@map("visit_pass")
}

model MasterAffiliation {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  masterId        String    @map("master_id") @db.Uuid
  orgId           String    @map("org_id")
  status          String    @default("active") // active | suspended | terminated
  since           DateTime  @db.Date
  until           DateTime? @db.Date
  skillTags       String[]  @map("skill_tags")
  hourlyCostTiyin BigInt    @default(0) @map("hourly_cost_tiyin") // у разных операторов разная
  objectIds       String[]  @map("object_ids") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  master MasterProfile @relation(fields: [masterId], references: [id])

  @@unique([tenantId, masterId, orgId])
  @@index([tenantId, orgId, status])
  @@map("master_affiliation")
}

model BuildingStaff {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  buildingId String    @map("building_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  staffRole  StaffRole @map("staff_role")
  isDuty     Boolean   @default(false) @map("is_duty")
  isBackup   Boolean   @default(false) @map("is_backup") // резервный согласующий — обязателен для active
  skillTags  String[]  @map("skill_tags")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  building Building @relation(fields: [buildingId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, buildingId, userId, staffRole])
  @@index([tenantId, buildingId, staffRole])
  @@map("building_staff")
}

model BuildingEquipment {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  commonZoneId   String?   @map("common_zone_id") @db.Uuid
  equipmentType  String    @map("equipment_type")
  model          String?
  serial         String?
  commissionedAt DateTime? @map("commissioned_at") @db.Date
  intervalDays   Int?      @map("interval_days") // регламент ТО; полноценный SERVICE_INTERVAL — в своём майлстоуне
  lastServiceAt  DateTime? @map("last_service_at") @db.Date
  isLicensed     Boolean   @default(false) @map("is_licensed") // газ, лифты — мастерам платформы не назначается
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  building Building @relation(fields: [buildingId], references: [id])

  @@index([tenantId, buildingId])
  @@map("building_equipment")
}

model BuildingObservation {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  buildingId     String              @map("building_id") @db.Uuid
  commonZoneId   String?             @map("common_zone_id") @db.Uuid
  unitId         String?             @map("unit_id") @db.Uuid
  authorUserId   String              @map("author_user_id") @db.Uuid
  source         ObservationSource   @default(walkthrough)
  categoryId     String              @map("category_id") // справочник A-44
  severity       ObservationSeverity @default(housekeeping)
  photoIds       String[]            @map("photo_ids") @db.Uuid
  geoLat         Decimal?            @map("geo_lat") @db.Decimal(9, 6)
  geoLng         Decimal?            @map("geo_lng") @db.Decimal(9, 6)
  comment        String?
  status         String              @default("open") // open | routed | resolved | rejected
  routedTo       String?             @map("routed_to") // task | defect | order | contractor | journal
  routedEntityId String?             @map("routed_entity_id") @db.Uuid
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz()
  resolvedPhotoId String?            @map("resolved_photo_id") @db.Uuid // CHECK: status=resolved ⇒ NOT NULL
  clientOpUuid   String?             @map("client_op_uuid") @db.Uuid // офлайн-фиксация на обходе
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  building Building @relation(fields: [buildingId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])

  @@unique([tenantId, clientOpUuid])
  @@index([tenantId, buildingId, status])
  @@index([tenantId, commonZoneId, createdAt]) // дедупликация по зоне за N дней
  @@map("building_observation")
}

model BuildingAnnouncement {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  buildingId   String    @map("building_id") @db.Uuid
  kind         String    @default("notice") // notice | shutdown | emergency
  audience     String    @default("building") // building | entrance | riser | units
  unitIds      String[]  @map("unit_ids") @db.Uuid
  publishAt    DateTime  @map("publish_at") @db.Timestamptz()
  body         String
  authorUserId String    @map("author_user_id") @db.Uuid
  sentAt       DateTime? @map("sent_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  building Building @relation(fields: [buildingId], references: [id])

  @@index([tenantId, buildingId, publishAt])
  @@map("building_announcement")
}

model SlaPolicy {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  operatorOrgId   String   @map("operator_org_id")
  buildingId      String?  @map("building_id") @db.Uuid // null = политика по умолчанию для всех объектов
  categoryId      String?  @map("category_id")
  priority        String   @default("normal") // critical | high | normal | low
  responseMin     Int      @map("response_min")
  arrivalMin      Int      @map("arrival_min")
  resolutionMin   Int      @map("resolution_min")
  workingHoursOnly Boolean @default(true) @map("working_hours_only")
  escalationChain Json     @default("[]") @map("escalation_chain")
  penaltyTiyin    BigInt?  @map("penalty_tiyin")
  appliesToScope  String   @default("both") @map("applies_to_scope") // private | common_area | both
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  building Building?    @relation(fields: [buildingId], references: [id])
  orders   Order[]

  @@index([tenantId, operatorOrgId, buildingId])
  @@map("sla_policy")
}

model OperatorSubscription {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  operatorOrgId     String           @map("operator_org_id")
  plan              SubscriptionPlan @default(free)
  tenantKind        TenantKind       @map("tenant_kind")
  billingUnit       BillingUnit      @default(per_object) @map("billing_unit") // параметр 139
  unitsBilled       Int              @default(1) @map("units_billed") // per_object → 1; per_unit → число помещений
  priceTiyin        BigInt           @default(300000000) @map("price_tiyin") // 3 000 000 сум за единицу тарификации (параметр 138)
  periodFrom        DateTime         @map("period_from") @db.Timestamptz()
  periodTo          DateTime         @map("period_to") @db.Timestamptz()
  status            String           @default("active") // active | past_due | cancelled
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, operatorOrgId, periodFrom])
  @@map("operator_subscription")
}

// ЗАМЕТКА к майлстоуну планировщика: модель Shift ещё не заведена (появляется вместе с планировщиком).
// При её создании она ОБЯЗАНА содержать employer_org_id (uuid, nullable) — владельца смены,
// и EXCLUDE-ограничение на пересечение (master_id, hours) среди смен с непустым employer_org_id
// (DEV-02 §4.4 п.11, DEV-15 §7.8.4). Без этого мультиаффилиация мастера ломается.

/**
 * Запрос доступа в чужое помещение (C-56, DEV-15 §7.6).
 *
 * Стороны — телефоны, а не ссылки на `User`: житель отвечает по короткой
 * ссылке из SMS, и учётной записи у него может не быть вовсе.
 */
model UnitAccessRequest {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  buildingId        String    @map("building_id") @db.Uuid
  unitId            String    @map("unit_id") @db.Uuid
  /** Подпись помещения строкой: запрос переживает перенумерацию */
  unitLabel         String    @default("") @map("unit_label")
  /** Наряда может не быть: сосед заливает, а работа частная */
  permitId          String?   @map("permit_id") @db.Uuid
  orderId           String?   @map("order_id") @db.Uuid
  requestedByPhone  String    @map("requested_by_phone")
  masterId          String?   @map("master_id")
  masterName        String?   @map("master_name")
  reason            String
  windowFrom        DateTime  @map("window_from") @db.Timestamptz()
  windowTo          DateTime  @map("window_to") @db.Timestamptz()
  status            String    @default("requested")
  decidedByPhone    String?   @map("decided_by_phone")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz()
  declineReason     String?   @map("decline_reason")
  proposedFrom      DateTime? @map("proposed_from") @db.Timestamptz()
  proposedTo        DateTime? @map("proposed_to") @db.Timestamptz()
  /** Ожидание протухает, а не висит: мастер не может ждать сутки */
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz()
  /** Код ссылки уникален глобально — по нему открывается страница ответа */
  accessCode        String    @unique @map("access_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  building Building      @relation(fields: [buildingId], references: [id])
  permit   AccessPermit? @relation(fields: [permitId], references: [id])

  @@index([tenantId, unitId, createdAt(sort: Desc)])
  @@index([tenantId, permitId])
  @@map("unit_access_request")
}

/**
 * Память офлайн-синка мастера: клиентский ключ операции → наряд.
 *
 * Таблица, а не расчёт: результат первой попытки надо ВЕРНУТЬ повторной,
 * а не просто отклонить её. Без тенанта — ключ приходит с устройства и
 * уникален сам по себе.
 */
model PermitSyncOp {
  clientOpUuid String   @id @map("client_op_uuid")
  /**
   * Арендатор нужен собственный (m35). Изоляция «видно, если виден наряд»
   * превращала идемпотентность в зависимость от порядка записи, а смысл
   * таблицы ровно обратный: помнить о применённой операции даже тогда, когда
   * всё остальное пошло не так.
   */
  tenantId     String   @map("tenant_id") @db.Uuid
  permitId     String   @map("permit_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId])
  @@map("permit_sync_op")
}

/**
 * Закрытый учётный период (A-19).
 *
 * Отдельная сущность, а не флаг у проводки: закрывается период, а не запись,
 * и это самостоятельное решение с автором и временем.
 */
model AccountingPeriod {
  tenantId String   @map("tenant_id") @db.Uuid
  /** 'YYYY-MM' — период закрывается целым месяцем */
  period   String
  closedAt DateTime @default(now()) @map("closed_at") @db.Timestamptz()
  closedBy String?  @map("closed_by")

  @@id([tenantId, period])
  @@map("accounting_period")
}

/**
 * Смена мастера (ТЗ 17.3).
 *
 * Время — минуты от полуночи, а не момент: смена принадлежит дате и не
 * переезжает между часовыми поясами.
 */
model Shift {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  masterId   String   @map("master_id")
  /** Снимок имени: в наряде на день стоит то, что было напечатано */
  masterName String   @default("") @map("master_name")
  date       DateTime @db.Date
  startMin   Int      @map("start_min")
  endMin     Int      @map("end_min")
  /** Дежурный: плановые заявки на него не бронируются */
  isDuty     Boolean  @default(false) @map("is_duty")
  zone       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  bookings Booking[]

  @@index([tenantId, date])
  @@index([tenantId, masterId, date])
  @@map("shift")
}

/**
 * Бронь слота под заявку.
 *
 * Номер заявки лежит рядом с идентификатором: наряд на день печатается из
 * брони, а запрос за номером в orders означал бы зависимость планировщика
 * от заявок (DEV-07 §3).
 */
model Booking {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  shiftId     String   @map("shift_id") @db.Uuid
  masterId    String   @map("master_id")
  orderId     String   @map("order_id") @db.Uuid
  orderNumber String   @default("") @map("order_number")
  startMin    Int      @map("start_min")
  endMin      Int      @map("end_min")
  slots       Int      @default(1)
  normHours   Decimal  @default(0) @map("norm_hours") @db.Decimal(5, 2)
  /** Буфер на дорогу — часть брони, а не константа: зависит от зоны */
  bufferMin   Int      @default(0) @map("buffer_min")
  /** Якорная — жёсткое окно клиента; гибкую можно двигать */
  anchored    Boolean  @default(false)
  priority    Int      @default(8)
  /**
   * Двухчасовое окно, которое видит клиент. Хранится, а не считается из
   * слота: клиенту названо конкретное окно, и пересчёт при изменении правил
   * округления означал бы, что обещание поменялось задним числом.
   */
  clientWindowFromMin Int @default(0) @map("client_window_from_min")
  clientWindowToMin   Int @default(0) @map("client_window_to_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId, shiftId])
  @@index([tenantId, orderId])
  @@map("booking")
}

/**
 * Лист ожидания: заявка без брони, ждущая освободившийся слот.
 *
 * Ключ — заявка: она стоит в очереди один раз, и повторная попытка записаться
 * не должна двигать её вперёд.
 */
model WaitlistEntry {
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  orderNumber String   @default("") @map("order_number")
  normHours   Decimal  @default(0) @map("norm_hours") @db.Decimal(5, 2)
  priority    Int      @default(8)
  at          DateTime @default(now()) @db.Timestamptz()

  @@id([tenantId, orderId])
  @@index([tenantId, priority, at])
  @@map("waitlist_entry")
}

// ===========================================================================
// Разделы без таблиц (DEV-19). Проектирование, а не портирование: этих
// сущностей в DEV-02 не было — они появились в коде позже схемы.
//
// Общие правила, по которым здесь всё сделано:
//   · человек опознаётся телефоном, а не ссылкой на `User` — учётной записи
//     у жителя, консьержа и заявителя может не быть вовсе (см. m21);
//   · деньги — BigInt в тийинах с CHECK на неотрицательность;
//   · снимок (имя, номер, подпись) хранится рядом с идентификатором: документ
//     обязан читаться так, как был напечатан, даже если справочник изменили;
//   · jsonb — только для того, что читается целиком и никогда не ищется:
//     на него не наложить CHECK и не построить внятный индекс;
//   · дочерние коллекции — таблицы, если по ним считают или ищут.
// ===========================================================================

/**
 * Профиль клиента B2C.
 *
 * Ключ — телефон, а не выданный идентификатор: клиент входит по телефону, по
 * нему же приходят заявки из веб-карточки и по ссылке из SMS, где никакого
 * профиля ещё нет. Отдельный uuid добавил бы второй способ назвать того же
 * человека, и первый же импорт разложил бы его на два профиля.
 */
model ClientProfile {
  tenantId String @map("tenant_id") @db.Uuid
  phone    String
  fullName String @default("") @map("full_name")
  locale   String @default("ru") // ru | uz

  /**
   * Согласия — колонки, а не jsonb: по ним отвечают регулятору, и вопрос
   * «сколько человек дали согласие на маркетинг» должен быть запросом,
   * а не выгрузкой с разбором.
   */
  consentPersonalData Boolean   @default(false) @map("consent_personal_data")
  consentMarketing    Boolean   @default(false) @map("consent_marketing")
  consentAt           DateTime? @map("consent_at") @db.Timestamptz()

  /** Любимый мастер: снимок имени рядом — карточка могла быть переименована */
  favoriteMasterId   String? @map("favorite_master_id")
  favoriteMasterName String? @map("favorite_master_name")
  /** payme | click | uzum | card | cash — подставляется в оплату по умолчанию */
  preferredPaymentProvider String? @map("preferred_payment_provider")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  addresses         ClientAddress[]
  complaints        ClientComplaint[]
  promoWallet       ClientPromoWallet[]
  readNotifications ClientReadNotification[]

  @@id([tenantId, phone])
  @@map("client_profile")
}

/**
 * Адрес клиента.
 *
 * Подъезд, этаж и домофон — отдельные колонки, а не одна строка адреса:
 * мастер читает их по дороге, диспетчер по ним подсказывает, а слитая строка
 * заставляет разбирать её глазами в момент, когда человек стоит у подъезда.
 */
model ClientAddress {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  clientPhone String  @map("client_phone")
  label       String?
  street      String
  apartment   String?
  entrance    String?
  floor       String?
  intercom    String?
  hasLift     Boolean @default(false) @map("has_lift")
  comment     String?
  geoLat      Float?  @map("geo_lat")
  geoLng      Float?  @map("geo_lng")
  /** Основной адрес ровно один — частичный уникальный индекс в миграции */
  isPrimary   Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  client ClientProfile @relation(fields: [tenantId, clientPhone], references: [tenantId, phone], onDelete: Cascade)

  @@index([tenantId, clientPhone])
  @@map("client_address")
}

/**
 * Обращение клиента из приложения.
 *
 * Отдельно от `QualityComplaint`: сюда клиент пишет что угодно, включая
 * «не понравился запах» — а жалоба качества это уже заведённое дело со
 * сроками ответа и влиянием на рейтинг мастера. Ссылка ведёт от первого ко
 * второму, когда обращение признали жалобой.
 */
model ClientComplaint {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clientPhone String   @map("client_phone")
  type        String
  text        String
  orderId     String?  @map("order_id") @db.Uuid
  orderNumber String?  @map("order_number")
  photoIds    String[] @map("photo_ids")
  status      String   @default("new") // new | in_progress | resolved | closed
  resolution  String?
  /** Дело в качестве, если обращение переросло в жалобу */
  qualityId   String?  @map("quality_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  client ClientProfile @relation(fields: [tenantId, clientPhone], references: [tenantId, phone], onDelete: Cascade)

  @@index([tenantId, clientPhone, createdAt(sort: Desc)])
  @@map("client_complaint")
}

/**
 * Промокод в кошельке клиента.
 *
 * Таблица, а не список в профиле: по ней проверяют, не потрачен ли код, и
 * считают, сколько кодов раздали и сколько дошло до заказа.
 */
model ClientPromoWallet {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientPhone String    @map("client_phone")
  code        String
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz()
  usedAt      DateTime? @map("used_at") @db.Timestamptz()
  orderNumber String?   @map("order_number")

  client ClientProfile @relation(fields: [tenantId, clientPhone], references: [tenantId, phone], onDelete: Cascade)

  @@unique([tenantId, clientPhone, code])
  @@map("client_promo_wallet")
}

/**
 * Отметка «уведомление прочитано».
 *
 * Таблица, а не массив в профиле: массив рос бы без предела у активного
 * клиента и переписывался целиком на каждое открытие списка.
 */
model ClientReadNotification {
  tenantId       String   @map("tenant_id") @db.Uuid
  clientPhone    String   @map("client_phone")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz()

  client ClientProfile @relation(fields: [tenantId, clientPhone], references: [tenantId, phone], onDelete: Cascade)

  @@id([tenantId, clientPhone, notificationId])
  @@map("client_read_notification")
}

/**
 * Предложение заявки мастеру (M-12).
 *
 * Живёт секунды и умирает по сроку, но переживать перезапуск обязано: иначе
 * после выкладки все висящие предложения исчезают, а заявки остаются
 * нераспределёнными и никто об этом не узнаёт.
 *
 * Вилка оценки и доля мастера — снимок на момент предложения: мастер
 * принимает решение по названным цифрам, и пересчёт их задним числом при
 * смене прайса означал бы, что он согласился не на то.
 */
model MasterOffer {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  orderNumber String @map("order_number")
  masterId    String @map("master_id")
  masterName  String @default("") @map("master_name")
  category    String @default("")
  district    String @default("")
  urgency     String @default("normal") // normal | urgent | emergency

  slotStart DateTime? @map("slot_start") @db.Timestamptz()
  slotEnd   DateTime? @map("slot_end") @db.Timestamptz()

  estimateFromTiyin    BigInt @default(0) @map("estimate_from_tiyin")
  estimateToTiyin      BigInt @default(0) @map("estimate_to_tiyin")
  masterShareFromTiyin BigInt @default(0) @map("master_share_from_tiyin")

  distanceHint String? @map("distance_hint")
  /** Парная заявка: едут двое, и отказ одного снимает обоих */
  isPaired     Boolean @default(false) @map("is_paired")
  kind         String  @default("personal") // personal | express | helper
  ttlSeconds   Int     @default(60) @map("ttl_seconds")
  waitingSince DateTime? @map("waiting_since") @db.Timestamptz()

  status        String    @default("pending") // pending | accepted | declined | expired | revoked
  declineReason String?   @map("decline_reason")
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz()

  @@index([tenantId, masterId, status])
  @@index([tenantId, orderId])
  // Прогон таймера ищет только то, что ещё ждёт ответа
  @@index([tenantId, expiresAt])
  @@map("master_offer")
}

/**
 * Смена мастера: на линии или нет.
 *
 * Одна строка на мастера — состояние, а не журнал. Последняя геометка лежит
 * здесь же колонками: её спрашивают на каждом распределении, и join ради
 * двух чисел на горячем пути не окупается.
 */
model MasterShiftState {
  tenantId String   @map("tenant_id") @db.Uuid
  masterId String   @map("master_id")
  online   Boolean  @default(false)
  since    DateTime @default(now()) @db.Timestamptz()

  lastLat      Float?    @map("last_lat")
  lastLng      Float?    @map("last_lng")
  lastAccuracy Float?    @map("last_accuracy")
  lastPingAt   DateTime? @map("last_ping_at") @db.Timestamptz()

  @@id([tenantId, masterId])
  @@map("master_shift_state")
}

/**
 * Геособытие мастера.
 *
 * Append-only и отдельно от состояния: по нему разбирают спор «мастер не
 * выехал» и снимают санкцию, и переписывать его нельзя. Координаты
 * обнуляемы — отказ в доступе к геолокации это тоже событие, и молчание
 * приложения должно быть видно, а не выглядеть как отсутствие записи.
 */
model MasterGeoEvent {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  masterId String   @map("master_id")
  event    String
  lat      Float?
  lng      Float?
  orderId  String?  @map("order_id") @db.Uuid
  at       DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, masterId, at(sort: Desc)])
  @@map("master_geo_event")
}

/**
 * Уведомление мастеру.
 *
 * Текст хранится собранным, а аргументы — рядом: приложение показывает его на
 * языке мастера, и перевод делается при показе. Хранить только ключ нельзя —
 * тогда старое уведомление меняет смысл при правке словаря.
 */
model MasterNotification {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  masterId  String   @map("master_id")
  kind      String
  title     String
  body      String
  bodyArgs  Json     @default("[]") @map("body_args")
  priority  String   @default("normal")
  deepLink  String?  @map("deep_link")
  orderId   String?  @map("order_id") @db.Uuid
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, masterId, createdAt(sort: Desc)])
  @@map("master_notification")
}

/**
 * Апелляция мастера: на оценку, удержание, санкцию или жалобу.
 *
 * `reference` — свободная ссылка на то, что оспаривают: номер заявки, код
 * удержания, идентификатор жалобы. Внешнего ключа нет намеренно: предметы
 * спора живут в четырёх разных таблицах, и связь на все сразу означала бы
 * четыре обнуляемых колонки, из которых заполнена одна.
 */
model MasterAppeal {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  masterId   String    @map("master_id")
  subject    String // rating | deduction | sanction | complaint
  reference  String
  text       String
  status     String    @default("open") // open | accepted | rejected
  resolution String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()

  @@index([tenantId, masterId, status])
  @@map("master_appeal")
}

/** Чаевые мастеру: деньги мимо расчёта по заявке, но в его доходе */
model MasterTip {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  masterId    String   @map("master_id")
  orderId     String   @map("order_id") @db.Uuid
  orderNumber String   @map("order_number")
  amountTiyin BigInt   @map("amount_tiyin")
  at          DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, masterId, at(sort: Desc)])
  @@map("master_tip")
}

/**
 * Анкета кандидата в мастера (M-01…M-05).
 *
 * Ключ — телефон: анкета заводится до того, как у человека появляется
 * карточка мастера, и до первого входа в приложение. `masterId`
 * проставляется, когда кандидат принят, и до этого пуст — это и есть
 * граница между кандидатом и мастером.
 */
model MasterApplication {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  phone           String
  masterId        String?  @map("master_id")
  fullName        String   @map("full_name")
  experienceYears Int      @default(0) @map("experience_years")
  about           String?
  skillTags       String[] @map("skill_tags")
  zones           String[]
  transport       String   @default("public") // own_car | public
  taxMode         String   @default("self_employed") @map("tax_mode") // self_employed | gph
  referralCode    String?  @map("referral_code")
  facePhoto       String?  @map("face_photo")

  stage           String    @default("new")
  interviewAt     DateTime? @map("interview_at") @db.Timestamptz()
  rejectionReason String?   @map("rejection_reason")
  /** Пройденные модули обучения — коды, порядок неважен */
  trainingDone    String[]  @map("training_done")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  documents    MasterApplicationDocument[]
  toolChecks   MasterApplicationToolCheck[]
  examAttempts MasterApplicationExam[]

  @@unique([tenantId, phone])
  @@index([tenantId, stage])
  @@map("master_application")
}

/**
 * Документ кандидата.
 *
 * Таблица, а не jsonb: по ней строится очередь проверки — «покажи всех, у
 * кого паспорт загружен, но не проверен», — и это запрос, а не разбор
 * снимка в приложении.
 */
model MasterApplicationDocument {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  code          String
  name          String
  status        String  @default("missing") // missing | uploaded | verified | rejected
  file          String?
  comment       String?

  application MasterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, code])
  @@index([tenantId, status])
  @@map("master_application_document")
}

/** Подтверждение инструмента по навыку: без него мастера не выпускают на линию */
model MasterApplicationToolCheck {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  skill         String
  items         String[]
  confirmed     Boolean  @default(false)
  photo         String?

  application MasterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, skill])
  @@map("master_application_tool_check")
}

/**
 * Попытка экзамена.
 *
 * Каждая попытка — строка, а не перезапись результата: по числу попыток и по
 * тому, какие темы валятся, правят обучение. Перезапись оставила бы только
 * последнюю, и вопрос «где мы теряем людей» стал бы неотвечаемым.
 */
model MasterApplicationExam {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  score         Int
  wrongTopics   String[]  @map("wrong_topics")
  passedAt      DateTime? @map("passed_at") @db.Timestamptz()
  at            DateTime  @default(now()) @db.Timestamptz()

  application MasterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, applicationId, at])
  @@map("master_application_exam")
}

/**
 * Расходники у мастера в машине.
 *
 * Остаток, а не журнал: ключ — мастер и позиция каталога. Движения пишутся
 * пополнениями и списаниями по заявке, а здесь лежит то, что есть сейчас.
 */
model MasterStock {
  tenantId  String   @map("tenant_id") @db.Uuid
  masterId  String   @map("master_id")
  catalogId String   @map("catalog_id")
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([tenantId, masterId, catalogId])
  @@map("master_stock")
}

/** Пополнение сумки мастера: чек, сумма и что именно куплено */
model MasterStockRefill {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @id @db.Uuid
  masterId    String   @map("master_id")
  receiptFile String?  @map("receipt_file")
  totalTiyin  BigInt   @default(0) @map("total_tiyin")
  at          DateTime @default(now()) @db.Timestamptz()

  items MasterStockRefillItem[]

  @@index([tenantId, masterId, at(sort: Desc)])
  @@map("master_stock_refill")
}

model MasterStockRefillItem {
  id        String @id @db.Uuid
  refillId  String @map("refill_id") @db.Uuid
  catalogId String @map("catalog_id")
  qty       Int
  costTiyin BigInt @default(0) @map("cost_tiyin")

  refill MasterStockRefill @relation(fields: [refillId], references: [id], onDelete: Cascade)

  @@map("master_stock_refill_item")
}

/**
 * Код закупки: разрешение потратить деньги платформы в партнёрском магазине.
 *
 * Лимит — колонка с CHECK: код без потолка означает открытый кошелёк.
 * Накладная лежит рядом отдельной таблицей — по её позициям сверяют, что
 * куплено то, ради чего код выдавался.
 */
model PurchaseCode {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String
  orderId    String   @map("order_id") @db.Uuid
  masterId   String   @map("master_id")
  limitTiyin BigInt   @map("limit_tiyin")
  status     String   @default("active") // active | used | expired
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()

  invoiceFile       String?   @map("invoice_file")
  invoiceTotalTiyin BigInt?   @map("invoice_total_tiyin")
  invoiceAt         DateTime? @map("invoice_at") @db.Timestamptz()

  invoiceItems PurchaseInvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId, masterId, status])
  @@map("purchase_code")
}

model PurchaseInvoiceItem {
  id             String @id @db.Uuid
  purchaseCodeId String @map("purchase_code_id") @db.Uuid
  name           String
  amountTiyin    BigInt @map("amount_tiyin")

  purchaseCode PurchaseCode @relation(fields: [purchaseCodeId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_item")
}

/**
 * Единица оборудования платформы.
 *
 * Одна таблица на два реестра. В коде их было два: в `registry` — с
 * инвентарным номером, стоимостью и датой обслуживания, в `master-api` — с
 * категорией, требуемым навыком и фотографией. Это одна и та же вещь,
 * описанная дважды: перфоратор с инвентарным номером, который выдают мастеру
 * под акт. Два описания означали два ответа на вопрос «где сейчас этот
 * перфоратор», и расходились они бы ровно в момент спора о пропаже.
 *
 * Состояния сведены тоже: `repair` и `maintenance` — одно и то же, а вот
 * `lost` и `written_off` разное: утерянное ищут и взыскивают, списанное
 * закрыто.
 */
model EquipmentUnit {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  inventoryNo   String  @map("inventory_no")
  name          String
  category      String  @default("")
  requiredSkill String? @map("required_skill")
  costTiyin     BigInt  @default(0) @map("cost_tiyin")
  /** in_stock | issued | maintenance | lost | written_off */
  status        String  @default("in_stock")

  holderMasterId    String?   @map("holder_master_id")
  holderMasterName  String?   @map("holder_master_name")
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz()
  nextMaintenanceAt DateTime? @map("next_maintenance_at") @db.Timestamptz()
  photoFile         String?   @map("photo_file")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  acts EquipmentAct[]

  @@unique([tenantId, inventoryNo])
  @@index([tenantId, status])
  @@index([tenantId, holderMasterId])
  @@map("equipment_unit")
}

/**
 * Акт выдачи или возврата оборудования.
 *
 * Код подтверждения и признак подтверждения — колонки: акт без подтверждения
 * второй стороной не акт, а заявление одной из них, и по нему нельзя
 * взыскивать. Комплектность лежит строками — по ней спорят поимённо.
 */
model EquipmentAct {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  equipmentId String   @map("equipment_id") @db.Uuid
  masterId    String   @map("master_id")
  kind        String // issue | return
  photos      String[]
  discrepancy String?
  confirmCode String   @map("confirm_code")
  confirmed   Boolean  @default(false)
  at          DateTime @default(now()) @db.Timestamptz()

  equipment    EquipmentUnit          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  completeness EquipmentActItem[]

  @@index([tenantId, equipmentId, at(sort: Desc)])
  @@map("equipment_act")
}

model EquipmentActItem {
  id    String  @id @db.Uuid
  actId String  @map("act_id") @db.Uuid
  item  String
  ok    Boolean @default(true)

  act EquipmentAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@map("equipment_act_item")
}

/**
 * Партнёрский магазин.
 *
 * Кредитный лимит и текущая задолженность — колонки с CHECK: закупка сверх
 * лимита это решение, которое принимает человек, а не следствие того, что
 * никто не посчитал.
 */
model PartnerStore {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  categories       String[]
  creditLimitTiyin BigInt   @default(0) @map("credit_limit_tiyin")
  payableTiyin     BigInt   @default(0) @map("payable_tiyin")
  status           String   @default("active") // active | paused

  @@index([tenantId, status])
  @@map("partner_store")
}

/**
 * Расходник в каталоге «сумки мастера».
 *
 * Фикс-прайс, а не закупочная цена: по ТЗ 8.4 расходник из сумки идёт без
 * чека и вся сумма достаётся мастеру. Цена здесь — то, что видит клиент, и
 * менять её задним числом нельзя, поэтому в заявку она уходит снимком.
 */
model ConsumableCatalog {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  name          String
  unit          String
  fixPriceTiyin BigInt  @map("fix_price_tiyin")
  normPerOrder  String? @map("norm_per_order")

  @@unique([tenantId, name])
  @@map("consumable_catalog")
}

/**
 * Позиция склада платформы.
 *
 * Отдельно от сумки мастера и от оборудования: тут спецтехника, инструмент,
 * расходники и мерч, которые лежат на складе и выдаются под расписку или
 * продаются мастеру. Остаток — колонка, движения — своя таблица.
 */
model StockItem {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  category  String // special_equipment | tool | consumable | uniform_merch | other
  name      String
  unit      String
  qtyOnHand Int    @default(0) @map("qty_on_hand")
  /** Ниже этого остатка склад просит пополнения */
  minQty    Int    @default(0) @map("min_qty")
  costTiyin BigInt @default(0) @map("cost_tiyin")

  movements StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("stock_item")
}

/**
 * Движение по складу.
 *
 * Append-only: остаток пересчитывается из движений, а не правится руками.
 * Имя позиции продублировано снимком — накладная должна читаться так, как
 * была выписана, даже если позицию потом переименовали.
 */
model StockMovement {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stockItemId String   @map("stock_item_id") @db.Uuid
  itemName    String   @map("item_name")
  type        String // receipt | temp_use | sale_to_master | write_off | return
  qty         Int
  masterId    String?  @map("master_id")
  masterName  String?  @map("master_name")
  priceTiyin  BigInt?  @map("price_tiyin")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  item StockItem @relation(fields: [stockItemId], references: [id])

  @@index([tenantId, stockItemId, createdAt(sort: Desc)])
  @@map("stock_movement")
}

/**
 * Развилка мастера на заявке (M-20…M-27).
 *
 * Одна таблица на восемь видов, а не восемь таблиц: у всех одинаковый
 * жизненный цикл — мастер сообщил, диспетчер разобрал, — и различаются они
 * только содержимым, которое читается целиком и не ищется. Поэтому вид
 * колонкой, а подробности jsonb: разложить их по колонкам значило бы завести
 * два десятка обнуляемых полей, из которых заполнены два.
 */
model OrderBranch {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  masterId   String    @map("master_id")
  kind       String // no_access | client_unavailable | unsafe_abort | cant_go | conservation | shopping_list | helper_request | delay
  reasonCode String?   @map("reason_code")
  comment    String?
  payload    Json      @default("{}")
  status     String    @default("open") // open | resolved
  resolution String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()

  @@index([tenantId, orderId])
  @@index([tenantId, status, createdAt])
  @@map("order_branch")
}

/**
 * Выбор запчасти по трём уровням (M-24).
 *
 * Варианты — своя таблица, а не jsonb: в них деньги, а на jsonb не наложить
 * CHECK на неотрицательность и не посчитать, как часто клиент выбирает
 * дешёвый уровень. Второе — прямой вход в разговор о марже.
 */
model SpareTierOffer {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  masterId     String    @map("master_id")
  partName     String    @map("part_name")
  mode         String    @default("catalog") // catalog | photo
  chosenTier   String?   @map("chosen_tier") // economy | standard | premium
  status       String    @default("sent") // sent | chosen | expired
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  chosenAt     DateTime? @map("chosen_at") @db.Timestamptz()
  procuredAt   DateTime? @map("procured_at") @db.Timestamptz()
  procuredNote String?   @map("procured_note")

  variants SpareTierVariant[]

  @@index([tenantId, orderId])
  @@map("spare_tier_offer")
}

model SpareTierVariant {
  id          String  @id @db.Uuid
  offerId     String  @map("offer_id") @db.Uuid
  tier        String // economy | standard | premium
  title       String
  amountTiyin BigInt  @map("amount_tiyin")
  note        String?

  offer SpareTierOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, tier])
  @@map("spare_tier_variant")
}

/**
 * Допработы по фото (M-25).
 *
 * Два варианта — минимальный и полный, — и молчание клиента тоже исход:
 * `silent` это не «нет ответа», а состояние, из которого работа продолжается
 * по минимальному варианту. Ступени эскалации лежат строками: по ним видно,
 * дошло ли до звонка диспетчера, и это спрашивают при разборе.
 */
model AddworkOffer {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  masterId      String    @map("master_id")
  photoCount    Int       @default(0) @map("photo_count")
  status        String    @default("sent") // sent | approved | declined | silent
  chosenVariant String?   @map("chosen_variant") // minimal | full
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz()

  variants   AddworkVariant[]
  escalation AddworkEscalation[]

  @@index([tenantId, orderId])
  @@map("addwork_offer")
}

model AddworkVariant {
  id         String @id @db.Uuid
  offerId    String @map("offer_id") @db.Uuid
  kind       String // minimal | full
  title      String
  totalTiyin BigInt @map("total_tiyin")

  offer AddworkOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  lines AddworkLine[]

  @@unique([offerId, kind])
  @@map("addwork_variant")
}

model AddworkLine {
  id          String @id @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  name        String
  amountTiyin BigInt @map("amount_tiyin")
  qty         Int    @default(1)

  variant AddworkVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("addwork_line")
}

model AddworkEscalation {
  id      String   @id @db.Uuid
  offerId String   @map("offer_id") @db.Uuid
  step    String
  at      DateTime @db.Timestamptz()
  done    Boolean  @default(false)

  offer AddworkOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("addwork_escalation")
}

/**
 * Рекомендация мастера на будущее (M-26).
 *
 * Не заявка и не смета: мастер увидел, что скоро потечёт, и назвал цену.
 * Отложенная рекомендация — отдельный исход, а не отказ: по ней возвращаются
 * через месяц, и путать её с «клиент отказался» значит терять работу.
 */
model Recommendation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  masterId  String   @map("master_id")
  comment   String?
  status    String   @default("sent") // sent | accepted | declined | postponed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  lines RecommendationLine[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("recommendation")
}

model RecommendationLine {
  id               String @id @db.Uuid
  recommendationId String @map("recommendation_id") @db.Uuid
  name             String
  amountTiyin      BigInt @map("amount_tiyin")
  qty              Int    @default(1)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("recommendation_line")
}

/**
 * Объект обслуживания у клиента: котёл, кондиционер, машина.
 *
 * Заводится по заявке и живёт дольше неё: по нему видно историю работ и
 * подходит ли запчасть. `plateUnreadable` — не мелочь: если шильдик не
 * читается, марка и модель записаны со слов, и полагаться на них при заказе
 * запчасти нельзя.
 */
model ClientAsset {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  clientPhone     String   @map("client_phone")
  type            String
  brand           String?
  model           String?
  year            Int?
  plateUnreadable Boolean  @default(false) @map("plate_unreadable")
  linkedWork      String[] @map("linked_work")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, clientPhone])
  @@map("client_asset")
}

/**
 * План работы этапами (M-27).
 *
 * Одна строка на заявку: этапность — свойство работы, а не отдельная
 * сущность. Паузы между этапами хранятся минимумом и максимумом: бетон
 * должен схватиться не меньше суток, но и не больше трёх, иначе шов
 * придётся вырубать.
 */
model StagePlan {
  tenantId          String  @map("tenant_id") @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  allSlotsConfirmed Boolean @default(false) @map("all_slots_confirmed")

  stages StagePlanStage[]

  @@id([tenantId, orderId])
  @@map("stage_plan")
}

model StagePlanStage {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  index         Int
  title         String
  normHours     Decimal   @default(0) @map("norm_hours") @db.Decimal(5, 2)
  pauseMinHours Int       @default(0) @map("pause_min_hours")
  pauseMaxHours Int       @default(0) @map("pause_max_hours")
  slotAt        DateTime? @map("slot_at") @db.Timestamptz()
  status        String    @default("planned") // planned | booked | done

  plan StagePlan @relation(fields: [tenantId, orderId], references: [tenantId, orderId], onDelete: Cascade)

  @@unique([tenantId, orderId, index])
  @@map("stage_plan_stage")
}

/**
 * Акт осмотра B2B (F-01…F-06).
 *
 * Документ, который подписывает ответственный на точке, и по которому потом
 * заводятся заявки на устранение. Отсюда всё остальное: снимки имён и
 * подписи хранятся рядом, а не подтягиваются связями — акт обязан читаться
 * так, как был подписан, даже если человек уволился, а точка переименована.
 *
 * `representativeAbsent` — не то же самое, что пустой представитель: акт,
 * составленный при отсутствии ответственного, имеет другой вес в споре, и
 * это должно быть видно в самом акте, а не выводиться из пустоты поля.
 */
model InspectionAct {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  number         String
  orderId        String  @map("order_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  locationName   String  @map("location_name")
  masterId       String  @map("master_id")
  masterName     String  @map("master_name")

  status String @default("draft") // draft | sent | signed | rejected | expired

  representativeName  String? @map("representative_name")
  representativePhone String? @map("representative_phone")
  representativeAbsent Boolean @default(false) @map("representative_absent")
  decidedByName       String? @map("decided_by_name")
  decidedByPhone      String? @map("decided_by_phone")
  rejectionReason     String? @map("rejection_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  sentAt    DateTime? @map("sent_at") @db.Timestamptz()
  decidedAt DateTime? @map("decided_at") @db.Timestamptz()
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()

  checklist ActChecklistZone[]
  items     ActDefectItem[]

  @@unique([tenantId, number])
  @@index([tenantId, organizationId, createdAt(sort: Desc)])
  @@index([tenantId, orderId])
  @@map("inspection_act")
}

/**
 * Зона чек-листа в акте.
 *
 * Строками, а не jsonb: «в скольких актах за квартал котельная отмечена
 * неисправной» — это запрос, ради которого чек-лист и заполняют.
 */
model ActChecklistZone {
  id    String  @id @db.Uuid
  actId String  @map("act_id") @db.Uuid
  zone  String
  ok    Boolean @default(true)
  note  String?

  act InspectionAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@unique([actId, zone])
  @@map("act_checklist_zone")
}

/**
 * Позиция дефекта в акте.
 *
 * Решение по каждой позиции принимается отдельно — часть устраняют сразу,
 * часть откладывают, часть отклоняют с причиной. Заявка, заведённая по
 * позиции, ссылается сюда: так видно, что из акта дошло до работы.
 */
model ActDefectItem {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actId         String   @map("act_id") @db.Uuid
  category      String
  description   String
  severity      String   @default("medium") // low | medium | high
  photoIds      String[] @map("photo_ids")
  estimateTiyin BigInt?  @map("estimate_tiyin")
  decision      String   @default("pending") // pending | accepted | declined | postponed
  declineReason String?  @map("decline_reason")
  /** Заявка, заведённая по этой позиции */
  orderId       String?  @map("order_id") @db.Uuid

  act InspectionAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([tenantId, decision])
  @@map("act_defect_item")
}

/**
 * Замена мастера на заявке (D-11).
 *
 * Причина и стадия — колонки: по ним считают, сколько замен из-за невыезда,
 * и это прямой вход в санкции. `clientNotified` отдельным полем, потому что
 * правило «молчание запрещено» проверяется по факту уведомления, а не по
 * намерению уведомить.
 */
model MasterReplacement {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  orderNumber String @map("order_number")
  reason      String // no_departure | declined | geo_stale | manual
  stage       String @default("detected") // detected | broadcast | assigned | escalated | closed

  fromMasterId   String? @map("from_master_id")
  fromMasterName String? @map("from_master_name")
  toMasterId     String? @map("to_master_id")
  toMasterName   String? @map("to_master_name")

  detectedAt         DateTime  @default(now()) @map("detected_at") @db.Timestamptz()
  broadcastStartedAt DateTime? @map("broadcast_started_at") @db.Timestamptz()
  /** Окно веерной рассылки: первый принявший забирает заявку */
  broadcastSeconds   Int       @default(120) @map("broadcast_seconds")
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz()

  clientNotified Boolean @default(false) @map("client_notified")
  sanction       String  @default("none") // none | warning | no_show | blocked
  note           String?

  @@index([tenantId, stage])
  @@index([tenantId, orderId])
  @@map("master_replacement")
}

/**
 * Инцидент диспетчерской: авария на районе, отключение, массовый сбой.
 *
 * Заявки связаны отдельной таблицей, а не массивом: по ним считают масштаб
 * («сколько заявок задел этот инцидент»), а массив в строке пришлось бы
 * разбирать в приложении и переписывать целиком на каждую новую заявку.
 */
model DispatchIncident {
  id       String    @id @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  title    String
  zone     String
  category String
  openedAt DateTime  @default(now()) @map("opened_at") @db.Timestamptz()
  closedAt DateTime? @map("closed_at") @db.Timestamptz()
  openedBy String    @map("opened_by")
  note     String?

  orders DispatchIncidentOrder[]

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("dispatch_incident")
}

model DispatchIncidentOrder {
  incidentId String @map("incident_id") @db.Uuid
  orderId    String @map("order_id") @db.Uuid

  incident DispatchIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, orderId])
  @@map("dispatch_incident_order")
}

/**
 * Передача смены диспетчеров (D-20).
 *
 * Каждый пункт принимается отдельно и с подписью: «принял смену» целиком —
 * это способ не заметить незакрытый спор. Пока пункт не принят, он остаётся
 * висящим у сдающего.
 */
model ShiftHandover {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fromPhone  String    @map("from_phone")
  toPhone    String?   @map("to_phone")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()

  items ShiftHandoverItem[]

  @@index([tenantId, startedAt(sort: Desc)])
  @@map("shift_handover")
}

model ShiftHandoverItem {
  id         String    @id @db.Uuid
  handoverId String    @map("handover_id") @db.Uuid
  kind       String // replacement | incident | blocked | dispute | complaint | awaiting_payment | approval
  title      String
  detail     String
  accepted   Boolean   @default(false)
  acceptedBy String?   @map("accepted_by")
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()

  handover ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("shift_handover_item")
}

/**
 * Обращение клиента, которое требует действия диспетчера (D-19).
 *
 * Перенос, низкая оценка, сообщение — три разных повода с одним общим
 * свойством: у них есть срок и ответственный. Поэтому одна таблица с видом
 * колонкой, а не три очереди, каждую из которых надо не забыть посмотреть.
 */
model ClientRequest {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  kind        String // reschedule | low_rating | message
  orderId     String    @map("order_id") @db.Uuid
  orderNumber String    @map("order_number")
  clientPhone String    @map("client_phone")
  clientName  String?   @map("client_name")
  masterId    String?   @map("master_id")
  masterName  String?   @map("master_name")
  title       String
  detail      String
  dueAt       DateTime? @map("due_at") @db.Timestamptz()
  status      String    @default("new") // new | in_work | done
  takenByPhone String?  @map("taken_by_phone")
  resolution  String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  closedAt    DateTime? @map("closed_at") @db.Timestamptz()

  @@index([tenantId, status, dueAt])
  @@map("client_request")
}

/**
 * Жалоба качества (Q-01…Q-05).
 *
 * Два срока — на первый ответ и на резолюцию — хранятся моментами, а не
 * длительностями: они посчитаны один раз по политике, действовавшей в момент
 * подачи, и правка политики не должна задним числом делать жалобу
 * просроченной или наоборот.
 *
 * `confirmed` отдельно от `status`: жалоба может быть закрыта и при этом не
 * подтверждена. На рейтинг мастера влияет только подтверждённая — иначе
 * достаточно нажаловаться, чтобы испортить человеку доход.
 */
model QualityComplaint {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  orderId          String? @map("order_id") @db.Uuid
  orderNumber      String? @map("order_number")
  complainantPhone String  @map("complainant_phone")
  complainantName  String? @map("complainant_name")
  /** Жалоба руководителя организации идёт сразу старшему смены */
  isOrgManager     Boolean @default(false) @map("is_org_manager")
  type             String
  text             String
  masterId         String? @map("master_id")
  masterName       String? @map("master_name")
  status           String  @default("new") // new | in_progress | resolved | rejected

  slaFirstResponseAt DateTime  @map("sla_first_response_at") @db.Timestamptz()
  slaResolutionAt    DateTime  @map("sla_resolution_at") @db.Timestamptz()
  firstResponseAt    DateTime? @map("first_response_at") @db.Timestamptz()
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz()

  playbookCode String?  @map("playbook_code")
  resolution   String?
  confirmed    Boolean? // null — ещё не разобрано; false — вина не подтверждена
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, status, slaFirstResponseAt])
  @@index([tenantId, masterId])
  @@map("quality_complaint")
}

/**
 * Спор по деньгам на заявке (ТЗ 4.2).
 *
 * `masterShareBlocked` — колонка, а не следствие статуса: доля мастера
 * блокируется в момент открытия спора и разблокируется решением, и выводить
 * это из статуса значило бы, что при любой правке жизненного цикла деньги
 * молча уезжают не туда.
 */
model Dispute {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  orderNumber       String    @map("order_number")
  openedByPhone     String    @map("opened_by_phone")
  openedByRole      String    @map("opened_by_role") // client | dispatcher
  reason            String
  amountTiyin       BigInt    @map("amount_tiyin")
  status            String    @default("open") // open | escalated | resolved
  resolution        String? // for_client | for_master | compromise
  refundTiyin       BigInt?   @map("refund_tiyin")
  masterShareBlocked Boolean  @default(true) @map("master_share_blocked")
  handledByPhone    String?   @map("handled_by_phone")
  comment           String?
  escalationReason  String?   @map("escalation_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz()

  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@map("dispute")
}

/**
 * Дело о возмещении ущерба из резервного фонда (ТЗ 17.7).
 *
 * Регресс к мастеру ограничен долей от суммы — CHECK в миграции. Правило
 * держится базой, а не только кодом: это деньги человека, и ошибка здесь
 * стоит ему зарплаты.
 */
model DamageCase {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  description  String
  claimantName String   @map("claimant_name")
  amountTiyin  BigInt   @map("amount_tiyin")
  regressTiyin BigInt   @default(0) @map("regress_tiyin")
  masterId     String?  @map("master_id")
  masterName   String?  @map("master_name")
  status       String   @default("filed") // filed | review | approved | rejected | paid
  resolution   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, status])
  @@map("damage_case")
}

/**
 * Лид B2B из лендинга и обзвона.
 *
 * `utm` — jsonb: набор меток задаёт рекламная кампания, он меняется каждый
 * запуск, и колонки под него пришлось бы добавлять миграцией на каждую
 * новую кампанию. Ищут по стадии и по следующему касанию, а не по меткам.
 */
model Lead {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  company        String
  contactName    String    @map("contact_name")
  phone          String
  pointsCount    Int       @default(1) @map("points_count")
  objectType     String?   @map("object_type")
  stage          String    @default("new")
  rejectReason   String?   @map("reject_reason")
  utm            Json      @default("{}")
  note           String?
  /** Заполняется после конвертации в контрагента CRM */
  organizationId String?   @map("organization_id") @db.Uuid
  nextTouchAt    DateTime? @map("next_touch_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, stage, nextTouchAt])
  @@map("lead")
}

/**
 * Задача на обзвон: заявка с лендинга, лид B2B, кандидат в мастера.
 *
 * Срок хранится моментом, а не минутами от создания: SLA обзвона меняется
 * параметром, и пересчёт задним числом делал бы вчерашние задачи
 * просроченными без единого действия человека.
 */
model CallTask {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  kind       String // b2c_lead | b2b_lead | master_candidate
  title      String
  phone      String
  payload    Json      @default("{}")
  slaMinutes Int       @default(15) @map("sla_minutes")
  dueAt      DateTime  @map("due_at") @db.Timestamptz()
  status     String    @default("open") // open | done
  source     String
  utm        Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  doneAt     DateTime? @map("done_at") @db.Timestamptz()
  result     String?

  @@index([tenantId, status, dueAt])
  @@map("call_task")
}

/**
 * Промокод.
 *
 * Скидка ограничена CHECK 1–50%: сто процентов — это не промокод, а
 * бесплатная работа, и решаться она должна не опечаткой в поле.
 * Использования лежат отдельной таблицей: по ним проверяется правило
 * «только первый заказ» и считается, во что обошлась кампания.
 */
model PromoCode {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  discountPercent Int      @map("discount_percent")
  active          Boolean  @default(true)
  /** null — без предела использований */
  maxUses         Int?     @map("max_uses")
  usedCount       Int      @default(0) @map("used_count")
  comment         String?
  firstOrderOnly  Boolean  @default(false) @map("first_order_only")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  uses PromoUse[]

  @@unique([tenantId, code])
  @@map("promo_code")
}

model PromoUse {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  promoCodeId String   @map("promo_code_id") @db.Uuid
  phone       String
  orderId     String?  @map("order_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz()

  promo PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  // Один код — один раз на человека: правило проверяется базой, а не только
  // кодом, потому что два одновременных заказа обходят проверку в приложении
  @@unique([promoCodeId, phone])
  @@map("promo_use")
}

/**
 * Счёт лояльности клиента.
 *
 * Баланс — витрина: он пересчитывается из движений и хранится колонкой,
 * потому что его показывают в приложении на каждом экране.
 */
model LoyaltyAccount {
  tenantId     String   @map("tenant_id") @db.Uuid
  phone        String
  balanceTiyin BigInt   @default(0) @map("balance_tiyin")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  entries LoyaltyEntry[]

  @@id([tenantId, phone])
  @@map("loyalty_account")
}

/** Движение по счёту лояльности: начисление, ваучер, сторно */
model LoyaltyEntry {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  phone       String
  kind        String // accrual | voucher | storno
  amountTiyin BigInt   @map("amount_tiyin")
  note        String   @default("")
  at          DateTime @default(now()) @db.Timestamptz()

  account LoyaltyAccount @relation(fields: [tenantId, phone], references: [tenantId, phone], onDelete: Cascade)

  @@index([tenantId, phone, at(sort: Desc)])
  @@map("loyalty_entry")
}

/**
 * Ваучер.
 *
 * Выдаётся по FEFO — первым уходит ближайший к сгоранию, поэтому индекс по
 * сроку среди свободных. Номинал и срок неизменяемы после выпуска: ваучер —
 * обязательство, а не запись в справочнике.
 */
model Voucher {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  nominalTiyin  BigInt    @map("nominal_tiyin")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz()
  status        String    @default("free") // free | issued
  issuedToPhone String?   @map("issued_to_phone")
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz()

  @@unique([tenantId, code])
  @@index([tenantId, status, expiresAt])
  @@map("voucher")
}

/**
 * Короткая ссылка на публичную страницу.
 *
 * Одна таблица на три вида ссылок — веб-карточка заявки (W-01…W-05),
 * согласование наряда-допуска (W-06) и ответ жителя о доступе (C-56). В коде
 * они жили тремя наборами с одинаковыми полями, и код для них уже выдаётся
 * общей функцией общим алфавитом: человек диктует его по телефону, и два
 * разных алфавита означали бы, что он диктует то так, то этак.
 *
 * Общими стали и правила, которые иначе пришлось бы писать трижды: срок,
 * отзыв, счётчик открытий. Отзыв — то, ради чего это вообще ссылка, а не
 * подписанный токен: токен нельзя отозвать, а ссылку на отменённый наряд
 * открывать нельзя.
 */
model ShortLink {
  code     String   @id
  tenantId String   @map("tenant_id") @db.Uuid
  /** web_card | permit_approval | unit_access */
  kind     String
  /** Заявка, наряд или запрос доступа — на что ведёт ссылка */
  targetId String   @map("target_id") @db.Uuid
  /** Кому отправлена: по нему же ищут в журнале, кто согласовал */
  phone    String
  /** Объект — только у согласования наряда: очередь строится по объектам */
  buildingId String? @map("building_id") @db.Uuid

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  usedAt       DateTime? @map("used_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  opens        Int       @default(0)
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz()

  @@index([tenantId, kind, targetId])
  @@index([tenantId, phone])
  @@map("short_link")
}

/**
 * Состояние SLA по заявке.
 *
 * Три срока посчитаны один раз по политике, действовавшей на момент приёма
 * заявки, и хранятся моментами: правка политики не должна задним числом
 * делать заявку просроченной. `pausedMs` — накопленная пауза (ожидание
 * клиента, доступа, запчасти): без неё срок считался бы и тогда, когда
 * работать было нельзя.
 */
model SlaState {
  tenantId String @map("tenant_id") @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  policyId String @map("policy_id") @db.Uuid

  responseDue   DateTime @map("response_due") @db.Timestamptz()
  arrivalDue    DateTime @map("arrival_due") @db.Timestamptz()
  resolutionDue DateTime @map("resolution_due") @db.Timestamptz()

  /** Что уже нарушено и что уже выполнено — разные вещи, и обе нужны */
  breached String[]
  reached  String[]
  pausedMs Int      @default(0) @map("paused_ms")

  @@id([tenantId, orderId])
  @@index([tenantId, resolutionDue])
  @@map("sla_state")
}

/**
 * Строка расчёта с оператором.
 *
 * Подписка, взаимозачёт по заявкам, сервисный сбор — в одном журнале со
 * знаком: нетто-расчёт с оператором это разница, и считать её по трём
 * таблицам значит трижды не сойтись.
 */
model OperatorLedgerRow {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  operatorOrgId String   @map("operator_org_id")
  kind          String // subscription | claim | service_fee
  amountTiyin   BigInt   @map("amount_tiyin")
  note          String   @default("")
  at            DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, operatorOrgId, at(sort: Desc)])
  @@map("operator_ledger_row")
}

/**
 * Прогон таймера (PRD-05 §8).
 *
 * Журнал того, что делали фоновые правила: сколько заявок задето, что
 * получилось. Признак `simulated` обязателен — прогон вхолостую и прогон
 * по-настоящему различаются только им, и спутать их значит не понять,
 * почему у клиентов ничего не изменилось.
 */
model TimerRun {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  timer     String
  title     String
  result    String
  affected  Int      @default(0)
  simulated Boolean  @default(false)
  at        DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, timer, at(sort: Desc)])
  @@map("timer_run")
}

/**
 * Неудовлетворённый спрос.
 *
 * Клиент искал окно и не нашёл — это и есть самая дорогая аналитика в
 * системе: она показывает, где не хватает мастеров, причём до того, как это
 * увидят в выручке. Причина колонкой, потому что по ней и группируют.
 */
model DemandMiss {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  /** Дата, на которую искали окно, — календарный день, а не момент */
  date     DateTime @db.Date
  reason   String // no_windows | window_taken | out_of_zone
  category String?
  zone     String?
  at       DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, date])
  @@index([tenantId, reason, at])
  @@map("demand_miss")
}

/**
 * Отметка «этот шаг таймера уже сделан».
 *
 * Идемпотентность фоновых правил: дунинг шлёт напоминание об оплате один раз
 * на этап, авто-согласование закрывает наряд один раз. Ключ собирается из
 * кода таймера и того, к чему он применён, — заявки, наряда, дня.
 *
 * Своя таблица, а не поле у сущности: правил больше двадцати, и колонка под
 * каждое означала бы двадцать булевых полей у заявки, из которых заполнены
 * два.
 */
model TimerDone {
  tenantId String   @map("tenant_id") @db.Uuid
  key      String
  at       DateTime @default(now()) @db.Timestamptz()

  @@id([tenantId, key])
  @@map("timer_done")
}
